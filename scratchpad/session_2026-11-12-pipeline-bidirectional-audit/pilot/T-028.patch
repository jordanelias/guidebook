diff --git a/scripts/migrations/127_term_forms_occurrence.sql b/scripts/migrations/127_term_forms_occurrence.sql
new file mode 100644
index 0000000..2b99371
--- /dev/null
+++ b/scripts/migrations/127_term_forms_occurrence.sql
@@ -0,0 +1,141 @@
+-- 127_term_forms_occurrence.sql
+-- SCHEMA migration (T-028; design: workplan/2026-11-12-bidirectional-pipeline/tasks/T-028-design.md, sections 3, 7
+-- and 10; OD-03 resolved under delegation; OD-38 answered by the owner 2026-11-12). A concept is its term_id; its
+-- names are rows of ONE forms table, term_aliases; terms.canonical_en stays NOT NULL as our English descriptive
+-- label, never a form.
+--
+-- 1. term_aliases is rebuilt to one row per OCCURRENCE. Until now its primary key (term_id, alias, language) let a
+--    form be held once per language, so the same phrase in two jurisdictions' instruments could not both be
+--    recorded. The rebuild keys each row by form_id (= the row's old rowid, so search_execution_forms rows made by
+--    rowid under migration 126 still resolve) and puts a unique OCCURRENCE index in place of the key. Every column
+--    T-026 added is copied as it stands (its DEFAULT and CHECKs included). usage_type is new and NULL for every
+--    existing row: NULL is "not yet typed", which is the truth; it is typed by judgment when a row is next touched,
+--    never guessed here. Legacy alias_type values are not rewritten (design section 5).
+-- 2. search_execution_forms gains the FOREIGN KEY migration 126 could not declare on a rowid.
+-- 3. term_label_picks: the home of OD-38's pick. `rename-term --from-form` records who picked (judge) and why
+--    (reason), and the label it replaced, in typed columns, one row per pick, never as a trailer on scope_note.
+--    The label itself stays in terms.canonical_en; the row points at the form, it does not copy it.
+-- 4. v_term_names derives, per concept, whether our label is also an attested term and the name shown (E1, with
+--    OD-38's tie-break: the first recorded English instrument form until a named judge picks).
+-- Readers: db.py add-term, add-alias, rename-term, log-search, _name_holder, _near_terms; render (T-037).
+-- AFTER_DATA: 20261106053823
+
+CREATE TABLE _127_term_aliases (
+    form_id             INTEGER PRIMARY KEY AUTOINCREMENT,
+    term_id             TEXT NOT NULL REFERENCES terms(term_id),
+    alias               TEXT NOT NULL,
+    language            TEXT NOT NULL DEFAULT 'EN',
+    alias_type          TEXT NOT NULL
+                        CHECK(alias_type IN (
+                            'SYNONYM','TRANSLATION','NARROWER',
+                            'BROADER','DEPRECATED','DOMAIN'
+                        )),
+    jurisdiction        TEXT,
+    notes               TEXT,
+    created_at          TEXT NOT NULL,
+    created_by_session  TEXT NOT NULL,
+    updated_at          TEXT NOT NULL,
+    updated_by_session  TEXT NOT NULL,
+    observation_id      INTEGER REFERENCES observed_terms(observation_id),
+    attestation         TEXT NOT NULL DEFAULT 'unrecorded'
+                        CHECK (attestation IN ('instrument','other_source','owner_supplied','model_seed','unrecorded')),
+    source_url          TEXT CHECK (source_url IS NULL OR source_url GLOB 'http*://*'),
+    source_page         TEXT,
+    source_line         INTEGER CHECK (source_line IS NULL OR source_line > 0),
+    source_clause       TEXT,
+    usage_type          TEXT CHECK (usage_type IS NULL OR usage_type IN
+                            ('code_term','colloquial','regional_variant','outdated_or_disfavoured','product_name')),
+    CHECK (attestation NOT IN ('instrument','other_source')
+           OR observation_id IS NOT NULL
+           OR (source_url IS NOT NULL AND (source_page IS NOT NULL OR source_clause IS NOT NULL))),
+    CHECK (attestation IN ('instrument','other_source')
+           OR (source_url IS NULL AND source_page IS NULL AND source_line IS NULL AND source_clause IS NULL))
+);
+
+INSERT INTO _127_term_aliases (form_id, term_id, alias, language, alias_type, jurisdiction, notes, created_at,
+                               created_by_session, updated_at, updated_by_session, observation_id, attestation,
+                               source_url, source_page, source_line, source_clause, usage_type)
+SELECT rowid, term_id, alias, language, alias_type, jurisdiction, notes, created_at,
+       created_by_session, updated_at, updated_by_session, observation_id, attestation,
+       source_url, source_page, source_line, source_clause, NULL
+  FROM term_aliases;
+
+DROP TABLE term_aliases;
+ALTER TABLE _127_term_aliases RENAME TO term_aliases;
+
+CREATE UNIQUE INDEX ux_term_aliases_occurrence ON term_aliases
+    (term_id, alias, language, COALESCE(jurisdiction, ''), COALESCE(observation_id, 0),
+     COALESCE(source_url, ''), COALESCE(source_clause, ''), COALESCE(source_page, ''),
+     COALESCE(source_line, 0));
+CREATE INDEX idx_ta_alias    ON term_aliases(alias);
+CREATE INDEX idx_ta_language ON term_aliases(language);
+
+CREATE TABLE _127_search_execution_forms (
+    exec_id            INTEGER NOT NULL REFERENCES search_executions(exec_id),
+    form_id            INTEGER NOT NULL REFERENCES term_aliases(form_id),
+    created_at         TEXT NOT NULL,
+    created_by_session TEXT NOT NULL,
+    PRIMARY KEY (exec_id, form_id)
+) STRICT;
+INSERT INTO _127_search_execution_forms SELECT exec_id, form_id, created_at, created_by_session
+  FROM search_execution_forms;
+DROP TABLE search_execution_forms;
+ALTER TABLE _127_search_execution_forms RENAME TO search_execution_forms;
+
+CREATE TABLE term_label_picks (
+    pick_id            INTEGER PRIMARY KEY AUTOINCREMENT,
+    term_id            TEXT NOT NULL REFERENCES terms(term_id),
+    form_id            INTEGER NOT NULL REFERENCES term_aliases(form_id),
+    former_label       TEXT NOT NULL,
+    judge              TEXT NOT NULL CHECK (length(trim(judge)) > 0),
+    reason             TEXT NOT NULL CHECK (length(trim(reason)) > 0),
+    created_at         TEXT NOT NULL,
+    created_by_session TEXT NOT NULL
+) STRICT;
+
+CREATE VIEW v_term_names AS
+-- v_term_names: what a concept is called. The only reader of the name shown (T-028 design section 7).
+-- Members of a concept's class are term_aliases rows whose alias_type is not NARROWER or BROADER; only an
+-- attested member (instrument, other_source) is vocabulary (E4). Rules, in order:
+--   english_instrument_label  our label equals an English form an instrument of an owed English-language
+--                             jurisdiction (v_research_scope) uses -- also how rename-term --from-form's pick shows;
+--   english_instrument_form   else the FIRST RECORDED such form (OD-38, until a named judge picks);
+--   origin_instrument_form    else the first recorded instrument form in any language, in its own language (E1);
+--   label_ours                else our label, which a page marks as ours.
+WITH attested AS (
+    SELECT form_id, term_id, alias, upper(language) AS language, jurisdiction, attestation
+      FROM term_aliases
+     WHERE alias_type NOT IN ('NARROWER','BROADER')
+       AND attestation IN ('instrument','other_source')),
+en_instrument AS (
+    SELECT a.* FROM attested a
+     WHERE a.attestation = 'instrument' AND a.language = 'EN'
+       AND EXISTS (SELECT 1 FROM v_research_scope r
+                    WHERE upper(r.language) = 'EN' AND r.jurisdiction = a.jurisdiction)),
+pick AS (
+    SELECT t.term_id, t.canonical_en,
+           (SELECT form_id FROM en_instrument e WHERE e.term_id = t.term_id
+              AND lower(e.alias) = lower(t.canonical_en) ORDER BY form_id LIMIT 1) AS en_label_form,
+           (SELECT MIN(form_id) FROM en_instrument e WHERE e.term_id = t.term_id) AS en_first_form,
+           (SELECT MIN(form_id) FROM attested o WHERE o.term_id = t.term_id
+              AND o.attestation = 'instrument') AS origin_form
+      FROM terms t)
+SELECT p.term_id,
+       p.canonical_en AS label,
+       EXISTS (SELECT 1 FROM attested a WHERE a.term_id = p.term_id
+                 AND lower(a.alias) = lower(p.canonical_en)) AS label_is_instrument_term,
+       CASE WHEN p.en_label_form IS NOT NULL THEN 'english_instrument_label'
+            WHEN p.en_first_form IS NOT NULL THEN 'english_instrument_form'
+            WHEN p.origin_form   IS NOT NULL THEN 'origin_instrument_form'
+            ELSE 'label_ours' END AS display_basis,
+       COALESCE(p.en_label_form, p.en_first_form, p.origin_form) AS display_form_id,
+       COALESCE((SELECT alias FROM term_aliases f
+                  WHERE f.form_id = COALESCE(p.en_label_form, p.en_first_form, p.origin_form)),
+                p.canonical_en) AS display_name,
+       COALESCE((SELECT upper(language) FROM term_aliases f
+                  WHERE f.form_id = COALESCE(p.en_label_form, p.en_first_form, p.origin_form)),
+                'EN') AS display_language,
+       p.origin_form AS origin_form_id
+  FROM pick p;
+
+PRAGMA user_version = 127;
