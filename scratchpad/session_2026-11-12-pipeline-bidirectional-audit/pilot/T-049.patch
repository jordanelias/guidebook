+def cell_key(conn, table: str) -> str:
+    """The SQL expression that keys a row of `table` for a translation pointer: its single-column
+    primary key, else `rowid`."""
+    pk = [c[1] for c in conn.execute('PRAGMA table_info("%s")' % table) if c[5]]
+    return '"%s"' % pk[0] if len(pk) == 1 else "rowid"
+
