+def read_cell(conn, table: str, column: str, key):
+    """The text cell a pointer names: (text, key_as_text, None), or (None, None, why it is not one).
+
+    ONE RULE for resolving a translation's pointer (`translations.source_*`, T-049), read by the
+    three translation verbs and by translation_pointer_audit alike. `key` is the row's single-column
+    primary key as text, or its rowid where the table has no single-column key (`cell_key`); the key
+    returned is the stored one, so `019` and `19` name one row once. Nothing is listed: the table and
+    the column are looked up in the live schema, so any text cell of any table can be pointed at, and
+    the cell must be text and not blank.
+    """
+    if not conn.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name=?", (table,)).fetchone():
+        return None, None, f"{table!r} is not a table of this database"
+    if column not in {c[1] for c in conn.execute('PRAGMA table_info("%s")' % table)}:
+        return None, None, f"{table!r} has no column {column!r}"
+    k = cell_key(conn, table)
+    try:
+        row = conn.execute('SELECT typeof("%s"), "%s", %s FROM "%s" WHERE %s = ?' % (column, column, k, table, k),
+                           (key,)).fetchone()
+    except sqlite3.OperationalError as exc:
+        return None, None, f"{table!r} cannot be keyed by {k} ({exc})"
+    if row is None:
+        return None, None, f"{table!r} has no row {k} = {key!r}"
+    if row[0] != "text" or not row[1].strip():
+        return None, None, (f"{table}.{column} at {k} = {key!r} is "
+                            f"{'blank' if row[0] == 'text' else row[0]}, not text")
+    return row[1], str(row[2]), None
+
