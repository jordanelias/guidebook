diff --git a/scripts/tests/test_translations.py b/scripts/tests/test_translations.py
new file mode 100644
index 0000000..325f97c
--- /dev/null
+++ b/scripts/tests/test_translations.py
@@ -0,0 +1,344 @@
+#!/usr/bin/env python3
+"""The typed home for translations (T-049): AT-107, AT-108, AT-109, proven to fire and to pass.
+
+WHAT REACHES THE GUIDEBOOK WITHOUT THESE CASES. A session that meets a Japanese or Dutch quotation either
+translates in its head and loses the translation, or writes an English paraphrase where the source's words
+should be and a later reader takes it for the source's. A translation that adds, drops or changes a figure
+passes every gate that asks only whether a translation EXISTS. A translation shown beside a quotation that
+has since changed. A stage name written into a verb's code, so that moving the default is a code change.
+
+AT-107  from the stage judgment, request and record a translation of a non-English figure's claim_text by the
+        verbs alone: the original cell is byte-identical, the current-translations view joins back to it by
+        its pointer, requested_at_stage is judgment, and no file under scripts/ or schemas/ is touched.
+AT-108  with the contract as committed a request with no --due-stage is listed at the contract's default
+        stage; with a temporary copy of the contract naming another stage it is listed there and not at
+        the first, with no file changed; no stage id is written as a literal inside the verbs.
+AT-109  a translation that changes a figure of the original is refused; one that drops a figure is refused;
+        one that keeps every figure is accepted; one of a quote that spells its number in words, stating the
+        numeral of the row's claimed_value, is accepted. A pointer to a table, column or row that does not
+        exist is refused; the original cannot be retyped; a cell changed since the request is refused;
+        review requires a reviewer other than the translator.
+
+Every probe is chosen by query. Anything written goes to a COPY of the database (marked TASK-FIXTURE); a
+state the verbs cannot build is made by SQL on the copy and marked HAND. A case needing a state the live data
+does not offer prints SKIPPED-NO-FIXTURE (counted apart), never silently passes.
+"""
+import ast
+import inspect
+import json
+import os
+import re
+import shutil
+import sqlite3
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[2]
+os.chdir(REPO)
+TMP = tempfile.mkdtemp(prefix="t049-translations-")
+DB = os.path.join(TMP, "guidebook.db")
+shutil.copy(REPO / "data" / "guidebook.db", DB)
+os.environ["GUIDEBOOK_DB_PATH"] = DB
+sys.path.insert(0, str(REPO / "scripts"))
+sys.path.insert(0, str(REPO))
+import db                                                              # noqa: E402
+import dbcore                                                          # noqa: E402
+from dbcore import Refusal                                             # noqa: E402
+from schemas.pipeline_contract import PipelineContract                 # noqa: E402
+
+S = "session_test-translations"
+results, skipped = [], []
+
+
+def record(tid, name, passed, details=""):
+    results.append(bool(passed))
+    print(f"  [{'✓' if passed else '✗'}] {tid}: {name}")
+    if details and not passed:
+        print(f"      {str(details)[:500]}")
+
+
+def skip(tid, why):
+    skipped.append(tid)
+    print(f"  [-] {tid}: SKIPPED-NO-FIXTURE: {why}")
+
+
+def refused(fn, *a, **k):
+    """The Refusal text if `fn` refuses, else None (any other exception is a defect and is printed)."""
+    try:
+        fn(*a, **k)
+    except Refusal as exc:
+        return str(exc)
+    except Exception as exc:  # noqa: BLE001
+        print(f"      DEFECT (not a refusal): {type(exc).__name__}: {exc}")
+    return None
+
+
+def refused_for(part, fn, *a, **k):
+    """True when `fn` refuses AND the refusal says `part`: refused for the reason under test, not another."""
+    return part in (refused(fn, *a, **k) or "\0")
+
+
+def cli(*args, env=None):
+    p = subprocess.run([sys.executable, "scripts/db.py", *args], capture_output=True, text=True,
+                       env={**os.environ, **(env or {})})
+    return p.returncode, p.stdout, p.stderr
+
+
+def finish():
+    print(f"\nEXAMINED: {len(results)} cases")
+    print(f"SKIPPED-NO-FIXTURE: {len(skipped)}")
+    ok = bool(results) and all(results)
+    if ok:
+        shutil.rmtree(TMP, ignore_errors=True)
+    else:
+        print(f"FAILED: {results.count(False)}   (scratch kept: {TMP})")
+    print("PASS" if ok else "FAIL")
+    sys.exit(0 if ok else 1)
+
+
+def tracked_state():
+    return subprocess.run(["git", "status", "--porcelain", "scripts", "schemas"], capture_output=True,
+                          text=True).stdout
+
+
+con = sqlite3.connect(DB)
+con.row_factory = sqlite3.Row
+q = lambda sql, *p: con.execute(sql, p).fetchall()  # noqa: E731
+
+# --- the schema and the verbs exist: absent, every case below is red by name ----------------------------
+have = q("SELECT count(*) FROM sqlite_master WHERE name IN ('translations', 'v_translations_current')")[0][0] == 2
+verbs = all(hasattr(db, f) for f in ("request_translation", "record_translation", "review_translation",
+                                     "translations_due"))
+record("T049-01", "the translations table, its current view and the four verbs exist", have and verbs,
+       f"table+view: {have}, verbs: {verbs}")
+if not (have and verbs):
+    finish()
+
+CONTRACT = PipelineContract.load(REPO / "governance" / "pipeline-contract.yaml")
+STAGES = [s.id for s in CONTRACT.stages]
+DEFAULT = CONTRACT.translation.default_stage if CONTRACT.translation else None
+record("T049-02", "the contract holds a translation rule naming one of its own stages", DEFAULT in STAGES, DEFAULT)
+
+# --- probes, chosen by query ------------------------------------------------------------------------------
+NUM = re.compile(r"\d+(?:[.,]\d+)?")
+TARGET = q("SELECT language FROM lang_jur_map GROUP BY language ORDER BY count(*) DESC, language LIMIT 1")[0][0]
+JUDGMENT = next((s for s in STAGES if s == "judgment"), None)
+FIG = [r for r in q(
+    "SELECT x.extraction_id AS id, x.claim_text AS text, x.claimed_value AS cv, upper(e.lang_detected) AS lang "
+    "FROM source_value_extractions x JOIN evidence_sources e USING (ref_id) "
+    "WHERE upper(coalesce(e.lang_detected, 'EN')) <> 'EN' AND upper(e.lang_detected) <> ? "
+    "AND x.claim_text IS NOT NULL ORDER BY x.extraction_id", TARGET)]
+# a figure whose numbers are plain integers, each once: so a changed or dropped one is unambiguous
+plain = next((r for r in FIG if (t := NUM.findall(r["text"])) and all(x.isdigit() for x in t)
+              and len(set(t)) == len(t) and not any(c in r["text"] for c in "０１２３４５６７８９〇一二三四五六七八九十")), None)
+words = next((r for r in FIG if r["cv"] and r["cv"].isdigit() and r["cv"] not in NUM.findall(r["text"])
+              and not re.search(r"[０-９〇一二三四五六七八九十]", r["text"])), None)
+
+
+def others_than(*langs):
+    """Languages lang_jur_map holds, other than these, in a stable order."""
+    marks = ",".join("?" * len(langs))
+    return [r[0] for r in q(f"SELECT DISTINCT language FROM lang_jur_map WHERE language NOT IN ({marks}) "
+                            f"ORDER BY language", *langs)]
+
+
+def pointer(r, column="claim_text"):
+    return ["--source-table", "source_value_extractions", "--source-column", column,
+            "--source-row-key", str(r["id"]), "--target-language", TARGET]
+
+
+def cell(r):
+    return q("SELECT claim_text FROM source_value_extractions WHERE extraction_id=?", r["id"])[0][0]
+
+
+# === AT-107 ===================================================================================================
+if not plain or not JUDGMENT:
+    skip("T049-10", f"no non-English figure with plain integers to translate (plain={bool(plain)}, "
+                    f"judgment stage={bool(JUDGMENT)})")
+else:
+    before_cell, before_tree = cell(plain), tracked_state()
+    text = "TASK-FIXTURE " + " ".join(NUM.findall(plain["text"]))
+    rc1, out1, err1 = cli("request-translation", *pointer(plain), "--stage", JUDGMENT, "--session", S)
+    tid = json.loads(out1)["translation_id"] if rc1 == 0 else None
+    rcl, outl, _ = cli("translations", "--due-at", DEFAULT)                              # AT-108, while it is open
+    listed_open = rcl == 0 and tid in [r["translation_id"] for r in json.loads(outl)]
+    rc2, out2, err2 = cli("record-translation", "--translation-id", str(tid), "--text", text,
+                          "--translator-kind", "model", "--translator-name", "test-translator", "--session", S)
+    record("T049-10", "AT-107 request and record by the verbs alone", rc1 == 0 and rc2 == 0, err1 + err2)
+    record("T049-11", "AT-107 the original cell is byte-identical", cell(plain) == before_cell)
+    joined = q("SELECT v.translation_id, v.translated_text FROM v_translations_current v "
+               "JOIN source_value_extractions x ON v.source_table='source_value_extractions' "
+               "AND v.source_column='claim_text' AND v.source_row_key=CAST(x.extraction_id AS TEXT) "
+               "WHERE x.extraction_id=? AND x.claim_text=?", plain["id"], before_cell)
+    record("T049-12", "AT-107 the current view joins back to that cell by its pointer",
+           [tuple(r) for r in joined] == [(tid, text)], joined)
+    record("T049-13", "AT-107 requested_at_stage is judgment",
+           q("SELECT requested_at_stage FROM translations WHERE translation_id=?", tid)[0][0] == JUDGMENT)
+    record("T049-14", "AT-107 no file under scripts/ or schemas/ was touched", tracked_state() == before_tree)
+
+    # === AT-108 =============================================================================================
+    record("T049-20", "AT-108 an unforced request is listed at the contract's default stage", listed_open)
+    # a request that is still open: the one above was answered, so open another on the same cell, in a third language
+    rq = json.loads(cli("request-translation", "--source-table", "source_value_extractions",
+                        "--source-column", "claim_text", "--source-row-key", str(plain["id"]),
+                        "--target-language", others_than(TARGET, plain["lang"])[0],
+                        "--stage", JUDGMENT, "--session", S)[1])
+    other = next(s for s in STAGES if s != DEFAULT)
+    alt = Path(TMP) / "contract-alt.yaml"
+    alt.write_text(re.sub(r"(?m)^(  default_stage: ).*$", rf"\g<1>{other}",
+                          (REPO / "governance" / "pipeline-contract.yaml").read_text(encoding="utf-8")))
+    tree = tracked_state()
+    at_default = [r["translation_id"] for r in db.translations_due(DEFAULT)]
+    at_alt = [r["translation_id"] for r in db.translations_due(other, contract_path=alt)]
+    still = [r["translation_id"] for r in db.translations_due(DEFAULT, contract_path=alt)]
+    record("T049-21", "AT-108 the open request is listed at the default stage",
+           rq["translation_id"] in at_default and rq["translation_id"] not in
+           [r["translation_id"] for r in db.translations_due(other)], at_default)
+    record("T049-22", "AT-108 a contract naming another stage moves it there and off the first",
+           rq["translation_id"] in at_alt and rq["translation_id"] not in still, (at_alt, still))
+    record("T049-23", "AT-108 moving the default changed no file under scripts/ or schemas/",
+           tracked_state() == tree)
+
+# no stage id is a literal inside the verbs: neither a string constant nor a word of a comment
+src = Path(db.__file__).read_text(encoding="utf-8")
+tree_ast = ast.parse(src)
+names = {"_translation_contract", "_translation_stage", "_cell_language", "translation_number_gaps",
+         "translation_claimed_value", "sha256_text", "_open_translation_request", "request_translation",
+         "record_translation", "review_translation", "translations_due"}
+fns = [n for n in tree_ast.body if isinstance(n, ast.FunctionDef) and n.name in names]
+stage_re = re.compile(r"\b(%s)\b" % "|".join(map(re.escape, STAGES)))
+lines = src.splitlines()
+hits = []
+for fn in fns:
+    doc = ast.get_docstring(fn, clean=False)
+    for i in range(fn.lineno, fn.end_lineno + 1):
+        code = lines[i - 1].split("#")[0] if "#" in lines[i - 1] and not lines[i - 1].lstrip().startswith("#") \
+            else lines[i - 1]
+        if stage_re.search(code) and not (doc and lines[i - 1].strip() in doc):
+            hits.append((fn.name, i, lines[i - 1].strip()[:80]))
+record("T049-24", "AT-108 no stage id is written as a literal inside the translation verbs",
+       len(fns) == len(names) and not hits, (len(fns), hits))
+
+# === AT-109 ===================================================================================================
+if not plain:
+    skip("T049-30", "no non-English figure with plain integers")
+else:
+    nums = NUM.findall(plain["text"])
+    changed = "TASK-FIXTURE " + " ".join([str(int(nums[0]) + 1000003)] + nums[1:])
+    dropped = "TASK-FIXTURE " + " ".join(nums[1:]) if len(nums) > 1 else "TASK-FIXTURE no figure at all"
+    kept = "TASK-FIXTURE " + " ".join(reversed(nums))
+    kw = dict(translator_kind="model", translator_name="test-translator", session=S)
+    LANG2, LANG3 = others_than(TARGET, plain["lang"])[1:3]       # AT-107 and AT-108 used the first two
+    ptr = dict(source_table="source_value_extractions", source_column="claim_text",
+               source_row_key=str(plain["id"]), target_language=LANG2, stage=JUDGMENT)
+    record("T049-30", "AT-109 a translation that changes a figure is refused",
+           refused_for("does not state the original's numbers", db.record_translation, changed, **ptr, **kw))
+    record("T049-31", "AT-109 a translation that drops a figure is refused",
+           refused_for("does not state the original's numbers", db.record_translation, dropped, **ptr, **kw))
+    r = db.record_translation(kept, **ptr, **kw)
+    record("T049-32", "AT-109 a translation that keeps every figure is accepted",
+           r["status"] == "translated", r)
+    record("T049-33", "AT-109 a pointer to a table that does not exist is refused",
+           refused_for("is not a table", db.request_translation, "no_such_table_t049", "claim_text", "1", TARGET, JUDGMENT, session=S))
+    record("T049-34", "AT-109 a pointer to a column that does not exist is refused",
+           refused_for("has no column", db.request_translation, "source_value_extractions", "no_such_column_t049", "1", TARGET,
+                   JUDGMENT, session=S))
+    record("T049-35", "AT-109 a pointer to a row that does not exist is refused",
+           refused_for("has no row", db.request_translation, "source_value_extractions", "claim_text", "-1", TARGET, JUDGMENT,
+                   session=S))
+    record("T049-36", "AT-109 a pointer to a cell that is not text is refused",
+           refused_for("not text", db.request_translation, "source_value_extractions", "extraction_id", str(plain["id"]), TARGET,
+                   JUDGMENT, session=S))
+    sigs = [set(inspect.signature(f).parameters) for f in (db.request_translation, db.record_translation,
+                                                           db.review_translation)]
+    helps = cli("record-translation", "--help")[1] + cli("request-translation", "--help")[1]
+    record("T049-37", "AT-109 the original cannot be retyped: no verb takes it",
+           not any({"original", "source_text", "original_text"} & s for s in sigs)
+           and "--original" not in helps and "--source-text" not in helps)
+    tid = r["translation_id"]
+    record("T049-38", "AT-109 review requires a reviewer",
+           refused_for("--reviewer-name is required", db.review_translation, tid, "reviewed", "model", "", session=S))
+    record("T049-39", "AT-109 the reviewer is never the translator",
+           refused_for("is the translator", db.review_translation, tid, "reviewed", "model", "test-translator", session=S))
+    record("T049-40", "AT-109 a rejection needs its reason",
+           refused_for("--reason is required", db.review_translation, tid, "rejected", "model", "test-reviewer", session=S))
+    ok = db.review_translation(tid, "reviewed", "model", "test-reviewer", session=S)
+    record("T049-41", "AT-109 a different reviewer reviews it", ok["status"] == "reviewed", ok)
+    # retire it in place by a corrected translation
+    fixed = db.record_translation("TASK-FIXTURE " + " ".join(nums), **ptr, **kw, supersedes=tid)
+    cur = [r[0] for r in q("SELECT translation_id FROM v_translations_current WHERE source_row_key=? "
+                           "AND target_language=?", str(plain["id"]), LANG2)]
+    record("T049-42", "a corrected translation is a new row and the old one leaves the current view",
+           cur == [fixed["translation_id"]], cur)
+    record("T049-43", "a cell translated once is not requested again (the correction names what it retires)",
+           refused_for("already translated", db.request_translation, *ptr.values(), session=S))
+
+    # a cell changed since the request: HAND, on a second copy
+    HAND = os.path.join(TMP, "hand.db")
+    shutil.copy(DB, HAND)
+    os.environ["GUIDEBOOK_DB_PATH"] = HAND
+    try:
+        rq = db.request_translation("source_value_extractions", "claim_text", str(plain["id"]), LANG3,
+                                    JUDGMENT, session=S)
+        h = sqlite3.connect(HAND)
+        h.execute("UPDATE source_value_extractions SET claim_text = claim_text || ' TASK-FIXTURE' "
+                  "WHERE extraction_id=?", (plain["id"],))       # HAND
+        h.commit()
+        h.close()
+        record("T049-44", "AT-109 recording against a cell changed since the request is refused",
+               refused_for("has changed since", db.record_translation, "TASK-FIXTURE " + " ".join(nums),
+                           translation_id=rq["translation_id"], **kw))
+        # the audit goes red on a current translation whose original has since changed (a seeded defect)
+        h = sqlite3.connect(HAND)
+        h.execute("UPDATE translations SET status='translated', translator_kind='model', translator_name='x', "
+                  "translated_text='TASK-FIXTURE' WHERE translation_id=?", (rq["translation_id"],))    # HAND
+        h.commit()
+        h.close()
+        p = subprocess.run([sys.executable, "scripts/audit/translation_pointer_audit.py"], capture_output=True,
+                           text=True, env={**os.environ, "GUIDEBOOK_DB_PATH": HAND})
+        record("T049-45", "translation_pointer_audit goes red on a stale pointer (a seeded defect)",
+               p.returncode == 1 and "has changed since" in p.stdout, p.stdout + p.stderr)
+    finally:
+        os.environ["GUIDEBOOK_DB_PATH"] = DB
+
+# a quote that spells its number in words: the numeral of the row's claimed_value may be stated
+if not words:
+    skip("T049-50", "no non-English figure whose claimed_value is not stated as a numeral in its quote")
+else:
+    others = NUM.findall(words["text"])
+    kw = dict(translator_kind="model", translator_name="test-translator", session=S)
+    ptr = dict(source_table="source_value_extractions", source_column="claim_text",
+               source_row_key=str(words["id"]), target_language=TARGET, stage=JUDGMENT)
+    w = db.record_translation("TASK-FIXTURE " + " ".join([words["cv"]] + others), **ptr, **kw)
+    record("T049-50", "AT-109 a number spelled in words is accepted when the translation states the numeral "
+                      "of the row's claimed_value", w["status"] == "translated", w)
+    record("T049-51", "AT-109 a number that is neither the quote's nor the claimed_value is still refused",
+           refused_for("does not state", db.record_translation,
+                       "TASK-FIXTURE " + " ".join([str(int(words["cv"]) + 1000003)] + others),
+                   **{**ptr, "target_language": others_than(TARGET, words["lang"])[0]},
+                   **kw))
+
+# the schema's own CHECKs, and the capture set
+bad = sqlite3.connect(DB)
+try:
+    bad.execute("INSERT INTO translations (source_table, source_column, source_row_key, source_sha256, "
+                "target_language, status, translated_text, translator_kind, translator_name, requested_at_stage, "
+                "reviewed_by_kind, reviewed_by_name, reviewed_at, created_at, created_by_session, updated_at, "
+                "updated_by_session) VALUES ('t','c','1',?, 'EN','reviewed','x','model','same',?, 'model','same',"
+                "'now','now',?, 'now',?)", ("0" * 64, STAGES[0], S, S))
+    reviewer_check = False
+except sqlite3.IntegrityError:
+    reviewer_check = True
+bad.close()
+record("T049-60", "the schema itself refuses a reviewer who is the translator", reviewer_check)
+record("T049-61", "translations is in the captured set the writers derive",
+       "translations" in dbcore.writable_tables(con))
+audit = subprocess.run([sys.executable, "scripts/audit/translation_pointer_audit.py"], capture_output=True,
+                       text=True, env={**os.environ, "GUIDEBOOK_DB_PATH": DB})
+n_current = q("SELECT count(*) FROM v_translations_current")[0][0]
