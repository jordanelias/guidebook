+def insert_quantity_kind(kind_id: str, definition: str, approval_ref: str, session: str,
+                         dry_run: bool = False):
+    """Add a kind of quantity to `base_quantity_kinds` on a recorded warrant (T-020, OD-24).
+
+    The kinds are rows so that a new one is data, not a code edit; the warrant is the dated
+    `## ` heading of the ledger entry that admits it, found exactly once (the pattern of
+    `mint-term-from-catalogue`: that proves the entry exists and is unambiguous, not that it
+    approves this kind). REFUSES: a blank field; a kind_id that is not lower-case words joined
+    by underscores; a definition carrying a number, a comparator or a min/max word (a kind
+    names a quantity, never a value); a kind already held; an approval that is not exactly
+    one ledger heading. Writes that one row and nothing else.
+    """
+    kind_id = (kind_id or "").strip()
+    definition = (definition or "").strip()
+    approval_ref = re.sub(r"^##\s+", "", (approval_ref or "").strip())
+    for flag, val in (("--kind-id", kind_id), ("--definition", definition),
+                      ("--approval-ref", approval_ref)):
+        if not val:
+            raise Refusal(f"add-quantity-kind: {flag} is required and may not be blank.")
+    if not re.fullmatch(r"[a-z]+(_[a-z]+)*", kind_id):
+        raise Refusal(f"add-quantity-kind: --kind-id {kind_id!r} must be lower-case words "
+                      f"joined by underscores (e.g. luminous_reflectance).")
+    vb = _VALUE_BEARING.search(definition)
+    if vb:
+        raise Refusal(f"add-quantity-kind: --definition carries a number, a comparator or a "
+                      f"min/max word ({vb.group(0)!r}). A kind names a quantity, never a value.")
+    n = dbcore.ledger_heading_count(approval_ref)
+    if n != 1:
+        raise Refusal(
+            f"add-quantity-kind: --approval-ref {approval_ref!r} is the heading of {n} ledger "
+            f"entries; it must be exactly one. Record the warrant in a dated entry of "
+            f"references/project-standards.md first, then give that entry's `## ` heading as "
+            f"written.")
+    with connect(dry_run) as conn:
+        held = conn.execute("SELECT kind_id FROM base_quantity_kinds WHERE kind_id=?",
+                            (kind_id,)).fetchone()
+        if held:
+            raise Refusal(f"add-quantity-kind: {kind_id!r} is already a kind. Nothing was written.")
+        row = {"kind_id": kind_id, "definition": definition, "approval_ref": approval_ref}
+        row.update(dbcore.stamp_for(conn, "base_quantity_kinds", session))
+        conn.execute(f"INSERT INTO base_quantity_kinds ({','.join(row)}) "
+                     f"VALUES ({','.join('?' * len(row))})", list(row.values()))
+        return {"kind_id": kind_id, "approval_ref": approval_ref, "dry_run": dry_run}
+
