@@ -0,0 +1,54 @@
+-- 126_quantity_kinds.sql
+-- SCHEMA migration -- a parameter states what kind of quantity it is (T-020, OD-24).
+--
+-- WHY. An element such as a grab bar could be promoted to a parameter, so it owed a reading from every
+-- source and was determined as a cell although it measures nothing. T-010 closed that with a list of refused
+-- term domains (dbcore.NON_QUANTITY_DOMAINS); this file replaces the list with the rule: each parameter
+-- states its quantity kind, from a table of kinds held as ROWS and extended by data with a warrant, not
+-- from a list typed in code. The delegated resolution of OD-24 (references/project-standards.md, "Delegated
+-- resolution 2026-11-12 -- OD-24 ...") seeds the table with exactly: length; gradient (ratio, percentage and
+-- degrees are notations of it, not kinds, so they get no row); force; time; luminous reflectance and its
+-- contrast (LRV); colour temperature.
+--
+-- TWO CHANGES, BOTH ADDITIVE, so neither needs create-copy-drop-rename:
+--   1. base_quantity_kinds: one row per kind. approval_ref is the dated `## ` heading of the ledger entry that
+--      admitted the kind, found exactly once in the ledger (db.py add-quantity-kind checks it, the pattern of
+--      mint-term-from-catalogue). The four session and time columns are those of base_parameters.
+--   2. base_parameters.quantity_kind, NULLABLE, a foreign key into it. The ten live parameters keep NULL until
+--      the research pull request that states their kinds (T-109); db.py add-parameter requires it for new ones.
+--      A CHECK that names the kind and anything else belongs in the writer, so there is none here.
+-- No element column is added: a parameter need not belong to an element (OD-24); elements reach parameters
+-- by term pointers (T-029).
+--
+-- Readers of base_parameters (re-derive: select type, name from sqlite_master where sql like '%base_parameters%'):
+-- views v_code_floor_only, v_item_provenance, v_source_reach_all, v_value_independence,
+-- v_determination_provenance, v_unregistered_roots, v_scan_ledger and the tables that point at it; an added
+-- trailing column changes none of them. Nothing is dropped, so no view or index needs recreating.
+
+CREATE TABLE base_quantity_kinds (
+    kind_id             TEXT PRIMARY KEY CHECK (length(trim(kind_id)) > 0),
+    definition          TEXT NOT NULL CHECK (length(trim(definition)) > 0),
+    approval_ref        TEXT NOT NULL CHECK (length(trim(approval_ref)) > 0),
+    created_at          TEXT NOT NULL,
+    created_by_session  TEXT NOT NULL,
+    updated_at          TEXT,
+    updated_by_session  TEXT
+);
+
+INSERT INTO base_quantity_kinds (kind_id, definition, approval_ref, created_at, created_by_session) VALUES
+ ('length', 'A distance between two points of the built environment, measured along a line (width, depth, height, reach, clearance).',
+  'Delegated resolution 2026-11-12 — OD-24 how coarse a parameter is, and its quantity kinds', '2026-11-13 00:00', 'migration_126_quantity_kinds'),
+ ('gradient', 'The rise of a surface over a run, stated as a ratio, a percentage or an angle in degrees; those are notations of one kind.',
+  'Delegated resolution 2026-11-12 — OD-24 how coarse a parameter is, and its quantity kinds', '2026-11-13 00:00', 'migration_126_quantity_kinds'),
+ ('force', 'A push, pull or torque that a person must apply to operate or move something.',
+  'Delegated resolution 2026-11-12 — OD-24 how coarse a parameter is, and its quantity kinds', '2026-11-13 00:00', 'migration_126_quantity_kinds'),
+ ('time', 'A duration, such as how long something stays open, stays lit or takes to cross.',
+  'Delegated resolution 2026-11-12 — OD-24 how coarse a parameter is, and its quantity kinds', '2026-11-13 00:00', 'migration_126_quantity_kinds'),
+ ('luminous_reflectance', 'The share of incident light a surface returns (light reflectance value, LRV), and the contrast between two surfaces that follows from it.',
+  'Delegated resolution 2026-11-12 — OD-24 how coarse a parameter is, and its quantity kinds', '2026-11-13 00:00', 'migration_126_quantity_kinds'),
+ ('colour_temperature', 'The hue of a white light source on the warm-to-cool scale.',
+  'Delegated resolution 2026-11-12 — OD-24 how coarse a parameter is, and its quantity kinds', '2026-11-13 00:00', 'migration_126_quantity_kinds');
+
+ALTER TABLE base_parameters ADD COLUMN quantity_kind TEXT REFERENCES base_quantity_kinds(kind_id);
+
+PRAGMA user_version = 126;
