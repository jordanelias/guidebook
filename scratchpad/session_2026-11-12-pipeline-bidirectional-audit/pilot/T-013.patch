diff --git a/scripts/migrations/126_typed_gap_subject_and_search_cause.sql b/scripts/migrations/126_typed_gap_subject_and_search_cause.sql
new file mode 100644
index 0000000..3343017
--- /dev/null
+++ b/scripts/migrations/126_typed_gap_subject_and_search_cause.sql
@@ -0,0 +1,29 @@
+-- 126_typed_gap_subject_and_search_cause.sql
+-- SCHEMA migration -- a gap says what it is a gap in, and a search says which gap caused it.
+--
+-- A gap named its parameter and its group only in its description, a sentence, so the book could
+-- not list the stated gaps for a parameter or a group, and a search run to close a gap could not
+-- say so (the backward step from a pending cell to research left no trail). The subject goes into
+-- columns that point at the registries the determination's own key points at, named exactly as on
+-- `specifications` (the parameter and the four lenses), plus the jurisdiction and language the
+-- shortfall is in; the search carries one pointer to the gap that caused it.
+--
+-- EIGHT NULLABLE COLUMNS, ALTER TABLE ... ADD COLUMN (no table rebuild: nothing is NOT NULL, no
+-- CHECK changes, and every column defaults to NULL, which SQLite allows beside a REFERENCES
+-- clause). NULL means "recorded before the subject was typed", which is what every existing gap
+-- and every existing search is; nothing is backfilled.
+-- Readers (re-derive with grep and sqlite_master): db.py add-gap / log-search / gaps, the
+-- assessment engine's pending-cell gap, the `v_pending` view (names its gap columns, so it is not
+-- touched). No other view or index names a column added here.
+
+ALTER TABLE gaps ADD COLUMN parameter_id INTEGER REFERENCES base_parameters(parameter_id);
+ALTER TABLE gaps ADD COLUMN identity_code TEXT REFERENCES "base_taxonomy_identity"(identity_code);
+ALTER TABLE gaps ADD COLUMN icf_code TEXT REFERENCES base_icf(icf_code);
+ALTER TABLE gaps ADD COLUMN needs_code TEXT REFERENCES access_needs(need_code);
+ALTER TABLE gaps ADD COLUMN medical_code TEXT REFERENCES base_taxonomy_medical(medical_code);
+ALTER TABLE gaps ADD COLUMN jurisdiction TEXT;
+ALTER TABLE gaps ADD COLUMN language TEXT;
+
+ALTER TABLE search_executions ADD COLUMN gap_id TEXT REFERENCES gaps(gap_id);
+
+PRAGMA user_version = 126;
diff --git a/scripts/tests/test_run_pipeline_refusals.py b/scripts/tests/test_run_pipeline_refusals.py
index 276505f..cda0336 100644
--- a/scripts/tests/test_run_pipeline_refusals.py
+++ b/scripts/tests/test_run_pipeline_refusals.py
@@ -1723,4 +1723,60 @@ with scratch() as c:
     else:
         skip("ST3", "no declared pair, or no linked source")
 
+
+# ─────────────────────── T-013: a gap names its subject; a search names the gap that caused it ───────────────────────
+print("Section T013: a gap is typed by the parameter and lens it is a gap in; a search points at the gap that caused it")
+NEED = scalar("SELECT need_code FROM access_needs ORDER BY need_code LIMIT 1")
+if ICF is None or P_NODIR is None or NEED is None:
+    skip("T013-01", "no ICF code or access need, or no active direction-less parameter holds an extraction "
+                    "(the pending-cell fixture)")
+else:
+    with scratch() as c:
+        rj = os.path.join(TMP, "t013.json")
+        # The needs lens makes this a different cell from the one E01 already determined on the copy.
+        r = assess(os.environ["GUIDEBOOK_DB_PATH"], P_NODIR, SLUG, "--needs", NEED, "--report-json", rj)
+        gid = (json.load(open(rj))[0] if r.returncode == 0 else {}).get("gap_register_id")
+        got = c.execute("SELECT parameter_id, identity_code, icf_code, needs_code, medical_code FROM gaps WHERE gap_id=?",
+                        (gid,)).fetchone()
+        record("T013-01", "assess_cell writes the pending cell's parameter and lens into the gap's own columns",
+               got is not None and tuple(got) == (P_NODIR, IDENT, ICF, NEED, None), (tuple(got) if got else gid, r.stderr[-200:]))
+with scratch() as c:
+    top_gap = c.execute("SELECT COALESCE(MAX(rowid), 0) FROM gaps").fetchone()[0]
+    p = cli("add-gap", "--category", cats[0], "--priority", pri, "--description", "TASK-FIXTURE typed gap",
+            "--session", S, "--parameter", str(P1), "--identity", IDENT)
+    row = c.execute("SELECT gap_id, parameter_id, identity_code, icf_code FROM gaps WHERE rowid > ?", (top_gap,)).fetchone()
+    record("T013-02", "add-gap --parameter and --identity are stored in the gap's columns", p.returncode == 0 and row is not None
+           and tuple(row)[1:] == (P1, IDENT, None), (p.stdout + p.stderr)[-250:] or tuple(row))
+    bad_p = c.execute("SELECT MAX(parameter_id) + 1 FROM base_parameters").fetchone()[0]
+    p = cli("add-gap", "--category", cats[0], "--priority", pri, "--description", "TASK-FIXTURE", "--session", S,
+            "--parameter", str(bad_p))
+    record("T013-03", "add-gap refuses a --parameter no base_parameters row holds, naming it, and writes no gap",
+           p.returncode != 0 and "base_parameters" in p.stderr + p.stdout and "IntegrityError" not in p.stderr
+           and c.execute("SELECT COUNT(*) FROM gaps WHERE rowid > ?", (top_gap,)).fetchone()[0] == 1,
+           (p.stdout + p.stderr)[-250:])
+    p = cli("add-gap", "--category", cats[0], "--priority", pri, "--description", "TASK-FIXTURE", "--session", S,
+            "--language", "ZZ")
+    record("T013-04", "add-gap refuses a --language lang_jur_map does not hold", p.returncode != 0
+           and "lang_jur_map" in p.stderr + p.stdout, (p.stdout + p.stderr)[-250:])
+    gap_held = c.execute("SELECT gap_id FROM gaps WHERE gap_id GLOB 'GAP-[0-9]*' "
+                          "ORDER BY CAST(SUBSTR(gap_id, 5) AS INTEGER) DESC LIMIT 1").fetchone()   # the highest, so far() of it is free
+    if gap_held is not None and PAIR:
+        top_se = c.execute("SELECT COALESCE(MAX(exec_id), 0) FROM search_executions").fetchone()[0]
+        p = cli("log-search", "--slug", SLUG, "--language", LANG, "--jurisdiction", JUR, "--query-text", "TASK-FIXTURE",
+                "--engine", "web", "--depth-method", "scoping", "--prior-expectation", "nothing",
+                "--gap-id", gap_held[0], "--session", S)
+        stored = c.execute("SELECT gap_id FROM search_executions WHERE exec_id > ?", (top_se,)).fetchall()
+        record("T013-05", "log-search --gap-id stores the gap that caused the search", p.returncode == 0
+               and [x[0] for x in stored] == [gap_held[0]], (p.stdout + p.stderr)[-250:] or [tuple(x) for x in stored])
+        p = cli("log-search", "--slug", SLUG, "--language", LANG, "--jurisdiction", JUR, "--query-text", "TASK-FIXTURE",
+                "--engine", "web", "--depth-method", "scoping", "--prior-expectation", "nothing",
+                "--gap-id", far(gap_held[0]), "--session", S)
+        record("T013-06", "log-search refuses a --gap-id no gap holds, naming gaps, and writes no search",
+               p.returncode != 0 and "gaps" in p.stderr + p.stdout and "IntegrityError" not in p.stderr
+               and c.execute("SELECT COUNT(*) FROM search_executions WHERE exec_id > ?", (top_se,)).fetchone()[0] == 1,
+               (p.stdout + p.stderr)[-250:])
+    else:
+        for t_ in ("T013-05", "T013-06"):
+            skip(t_, "no declared pair in a declared jurisdiction, or no gap held")
+
 finish()
