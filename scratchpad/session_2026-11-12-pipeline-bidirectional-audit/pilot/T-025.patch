+def _pair_row(conn, language, jurisdiction, verb):
+    """The lang_jur_map row for (language, jurisdiction), or a Refusal naming `verb`."""
+    row = conn.execute("SELECT role, scope_status FROM lang_jur_map WHERE language=? AND jurisdiction=?",
+                       (language, jurisdiction)).fetchone()
+    if row is None:
+        raise Refusal(f"{verb}: ({language!r}, {jurisdiction!r}) is not a pair lang_jur_map holds. "
+                      f"Add it with `db.py add-lang-jur-pair` first. Nothing was written.")
+    return row
+
+
+def add_lang_jur_pair(language: str, jurisdiction: str, role: str, ledger_pointer: str, session: str,
+                      notes: str = None, dry_run: bool = False):
+    """Add one (language, jurisdiction) pair to `lang_jur_map`, the table `v_research_scope` reads as
+    what the research scope owes. Which languages and countries are searched is the owner's scope
+    (a new language is a doctrine change, owner question 5), so every pair needs `--ledger-pointer`:
+    a quote found exactly once in the ledger. REFUSES: a blank or non-upper-case language; a
+    jurisdiction `base_jurisdictions` does not declare (`dbcore.check_jurisdiction`; admit it with
+    `add-jurisdiction` first); a role outside the column's CHECK; a pair already held (a pair's role is
+    never rewritten here); a ledger quote not found exactly once. The new pair is owed (scope_status NULL);
+    `set-pair-scope` records `scoped-out`. The result says when the language is new to the map."""
+    language, jurisdiction = (language or "").strip(), (jurisdiction or "").strip()
+    if not language or language != language.upper():
+        raise Refusal(f"add-lang-jur-pair: --language {language!r} must be non-blank and upper case.")
+    if not jurisdiction:
+        raise Refusal("add-lang-jur-pair: --jurisdiction is required.")
+    dbcore.require_ledger_quote_once((ledger_pointer or "").strip(), "add-lang-jur-pair: --ledger-pointer",
+                                     "Record the owner's scope decision in references/project-standards.md first (CLAUDE.md rule 0).")
+    dbcore.check_jurisdiction(jurisdiction, "add-lang-jur-pair --jurisdiction")
+    with connect(dry_run) as conn:
+        dbcore.check_declared(conn, "lang_jur_map", "role", role, "add-lang-jur-pair --role")
+        if conn.execute("SELECT 1 FROM lang_jur_map WHERE language=? AND jurisdiction=?",
+                        (language, jurisdiction)).fetchone():
+            raise Refusal(f"add-lang-jur-pair: ({language!r}, {jurisdiction!r}) is already held. Nothing was written.")
+        new_language = not dbcore.exists(conn, "lang_jur_map", "language", language)
+        row = {"language": language, "jurisdiction": jurisdiction, "role": role,
+               "notes": (notes or "").strip() or None}
+        row.update(dbcore.stamp_for(conn, "lang_jur_map", session))
+        conn.execute(f"INSERT INTO lang_jur_map ({','.join(row)}) VALUES ({','.join('?' * len(row))})",
+                     list(row.values()))
+        return {"language": language, "jurisdiction": jurisdiction, "role": role,
+                "new_language": new_language, "dry_run": dry_run}
+
+
+def set_pair_scope(language: str, jurisdiction: str, scope_status: str, ledger_pointer: str, reason: str,
+                   session: str, dry_run: bool = False):
+    """Record whether a held `lang_jur_map` pair is owed (`in-scope`) or `scoped-out`, printing the value it
+    replaces. The table keeps no history column, so the replaced value, the reason and the ledger pointer are
+    in this result and in the pull request. REFUSES: a pair not held; a value outside the column's CHECK;
+    a value the pair already has; a blank --reason; a ledger quote not found exactly once."""
+    language, jurisdiction = (language or "").strip(), (jurisdiction or "").strip()
+    reason = dbcore.require_reason(reason, "set-pair-scope")
+    dbcore.require_ledger_quote_once((ledger_pointer or "").strip(), "set-pair-scope: --ledger-pointer",
+                                     "Record the owner's scope decision in references/project-standards.md first (CLAUDE.md rule 0).")
+    with connect(dry_run) as conn:
+        dbcore.check_declared(conn, "lang_jur_map", "scope_status", scope_status, "set-pair-scope --scope-status")
+        was = _pair_row(conn, language, jurisdiction, "set-pair-scope")["scope_status"]
+        if was == scope_status:
+            raise Refusal(f"set-pair-scope: ({language!r}, {jurisdiction!r}) is already {scope_status!r}. "
+                          f"Nothing was written.")
+        conn.execute("UPDATE lang_jur_map SET scope_status=? WHERE language=? AND jurisdiction=?",
+                     (scope_status, language, jurisdiction))
+        return {"language": language, "jurisdiction": jurisdiction, "scope_status": scope_status,
+                "scope_status_was": was, "reason": reason, "dry_run": dry_run}
+
+
+def add_identity(code: str, display_name: str, category: str, description: str, ledger_pointer: str,
+                 session: str, parent: str = None, dry_run: bool = False):
+    """Add one code to `base_taxonomy_identity`, the identity lens every determination and search points at.
+    The code's name and place in the taxonomy are population taxonomy (the owner's), so `--ledger-pointer`
+    is a quote found exactly once in the ledger. REFUSES: a blank or non-upper-case code, or one held; a blank
+    name or description; a category outside the column's CHECK; a --parent that is not a held ACTIVE code;
+    a ledger quote not found exactly once. No provenance column exists: the provenance is the ledger entry the
+    quote points at (T-102-design section 12)."""
+    code, display_name, description = (code or "").strip(), (display_name or "").strip(), (description or "").strip()
+    parent = (parent or "").strip() or None
+    if not code or code != code.upper() or " " in code:
+        raise Refusal(f"add-identity: --code {code!r} must be non-blank, upper case, without spaces.")
+    if not display_name or not description:
+        raise Refusal("add-identity: --display-name and --description are required and may not be blank.")
+    dbcore.require_ledger_quote_once((ledger_pointer or "").strip(), "add-identity: --ledger-pointer",
+                                     "Record the owner's ruling in references/project-standards.md first (CLAUDE.md rule 0).")
+    with connect(dry_run) as conn:
+        dbcore.check_declared(conn, "base_taxonomy_identity", "category", category, "add-identity --category")
+        if dbcore.exists(conn, "base_taxonomy_identity", "identity_code", code):
+            raise Refusal(f"add-identity: {code!r} is already held. Nothing was written.")
+        if parent is not None:
+            held = conn.execute("SELECT status FROM base_taxonomy_identity WHERE identity_code=?", (parent,)).fetchone()
+            if held is None or held["status"] != "active":
+                raise Refusal(f"add-identity: --parent {parent!r} is not a held active identity code. "
+                              f"Nothing was written.")
+        row = {"identity_code": code, "display_name": display_name, "category": category,
+               "description": description, "parent_code": parent}
+        row.update(dbcore.stamp_for(conn, "base_taxonomy_identity", session))
+        row.update({k: v for k, v in dbcore.upd(session).items() if k == "updated_at"})
+        conn.execute(f"INSERT INTO base_taxonomy_identity ({','.join(row)}) VALUES ({','.join('?' * len(row))})",
+                     list(row.values()))
+        return {"identity_code": code, "parent_code": parent, "dry_run": dry_run}
+
+
+_AMENDABLE_IDENTITY_FIELDS = ("display_name", "description", "category")
+
+
+def amend_identity(code: str, ledger_pointer: str, reason: str, session: str, display_name: str = None,
+                   description: str = None, category: str = None, dry_run: bool = False):
+    """Correct the display name, description or category of a held identity code, printing each value it
+    replaces (the table keeps no history column; the result and the ledger entry the pointer names are the
+    record). The code is never renamed. REFUSES: no field given; a blank value; a category outside the
+    column's CHECK; a code not held; a value equal to the held one (reported as unchanged, nothing written
+    when every given field is unchanged); a blank --reason; a ledger quote not found exactly once."""
+    given = {k: (v or "").strip() for k, v in (("display_name", display_name), ("description", description),
+                                              ("category", category)) if v is not None}
+    if not given:
+        raise Refusal(f"amend-identity: give at least one of {list(_AMENDABLE_IDENTITY_FIELDS)}.")
+    if not all(given.values()):
+        raise Refusal("amend-identity: a given value may not be blank.")
+    reason = dbcore.require_reason(reason, "amend-identity")
+    dbcore.require_ledger_quote_once((ledger_pointer or "").strip(), "amend-identity: --ledger-pointer",
+                                     "Record the owner's ruling in references/project-standards.md first (CLAUDE.md rule 0).")
+    with connect(dry_run) as conn:
+        held = conn.execute("SELECT display_name, description, category FROM base_taxonomy_identity "
+                            "WHERE identity_code=?", (code,)).fetchone()
+        if held is None:
+            raise Refusal(f"amend-identity: {code!r} is not a held identity code.")
+        if "category" in given:
+            dbcore.check_declared(conn, "base_taxonomy_identity", "category", given["category"],
+                                  "amend-identity --category")
+        changes = {k: v for k, v in given.items() if held[k] != v}
+        if changes:
+            stamp = dbcore.upd(session)
+            conn.execute("UPDATE base_taxonomy_identity SET " + ", ".join(f"{k}=?" for k in changes) +
+                         ", updated_at=? WHERE identity_code=?", [*changes.values(), stamp["updated_at"], code])
+        return {"identity_code": code, "changed": bool(changes), "reason": reason,
+                "replaced": {k: held[k] for k in changes}, "now": changes, "dry_run": dry_run}
+
+
 def record_scan(data: dict, session: str, dry_run: bool = False):
     """Record one READING of one source against the parameter list (migration 103).
 
