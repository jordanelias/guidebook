+def t8_ok(claimed, key):
+    return ok(db._require_verbatim, T8_SENT[key], T8_REF, "--claim-text", "T-008", claimed_value=claimed)[1] is None
+
+
+for tid, claimed, key, why in [
+        ("T8-01", "12", "m", "a shifted decimal point: 12 is not 1.2"),
+        ("T8-02", "0.6", "s", "digits 0 and 6 are in 6.0 s, but 0.6 is not 6.0"),
+        ("T8-03", "1:1", "r", "1:1 is not 1:12"),
+        ("T8-04", "112", "r", "112 is not stated anywhere in 1:12"),
+        ("T8-05", "120.0", "sp", "120.0 is not 1 200"),
+        ("T8-24", "1:8", "in12", "1:8 is not 1 in 12")]:
+    r = t8(claimed, key)
+    record(tid, f"claimed_value {claimed!r} is refused against {T8_SENT[key][:40]!r}... ({why})",
+           r is not None and "claimed_value" in r, r)
+for tid, claimed, key in [
+        ("T8-06", "1.2", "m"), ("T8-07", "1.2", "de"), ("T8-08", "1200", "sp"), ("T8-09", "1:12", "ja"),
+        ("T8-10", "1:12", "r"), ("T8-11", "1/12", "r"), ("T8-12", "6", "s"), ("T8-13", "150000", "in"),
+        ("T8-14", "1234.56", "am"), ("T8-20", "1:12", "in12"), ("T8-21", "800", "tab"), ("T8-22", "750", "tab"),
+        ("T8-23", "1428.1", "std")]:
+    record(tid, f"claimed_value {claimed!r} is accepted against {T8_SENT[key][:40]!r}...", t8_ok(claimed, key),
+           ok(db._require_verbatim, T8_SENT[key], T8_REF, "--claim-text", "T-008", claimed_value=claimed)[1])
+r = t8("1.200", "ab")
+record("T8-15", "an ambiguous claimed_value (1.200: one point two, or twelve hundred) is refused and asks for the "
+                "unambiguous form", r is not None and "unambiguous" in r, r)
+# end to end through the writer, on the live full-scope source: the same refusals reach add-extraction.
+shifted = VALUE[:-1] + "." + VALUE[-1]
+r = refusal(db.insert_extraction, extraction(FULL_REF, P_FULL, claimed_value=shifted),
+            session=S, dry_run=True, relations=[])
+record("T8-16", "add-extraction refuses a decimal-shifted claimed_value under a quote that verifies", r is not None, r)
+r = refusal(db.insert_extraction, extraction(FULL_REF, P_FULL, claimed_value="twelve"),
+            session=S, dry_run=True, relations=[])
+record("T8-17", "add-extraction refuses a numerical claimed_value that contains no number", r is not None, r)
+res, err = ok(db.insert_extraction, extraction(FULL_REF, P_FULL, claim_type="qualitative", claimed_value="twelve"),
+              session=S, dry_run=True, relations=[])
+record("T8-18", "...but a qualitative claimed_value with no number is not a quantity and still passes",
