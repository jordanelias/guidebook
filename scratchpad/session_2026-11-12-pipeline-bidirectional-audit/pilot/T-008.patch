diff --git a/scripts/research/retrieval_log.py b/scripts/research/retrieval_log.py
index 5b0b13f..ec12910 100644
--- a/scripts/research/retrieval_log.py
+++ b/scripts/research/retrieval_log.py
@@ -644,6 +644,78 @@ def normalise_quote(text):
     return "".join(ch for ch in s if ch.isalnum())
 
 
+# A number as the page WRITES it, one alternative per way of writing it, most specific first.
+# Grouping and decimal marks are told apart by SHAPE, never guessed: 1.234,56 and 1,234.56 have
+# one reading, 1,50,000 and 1 200 have one, 1,2 is a decimal, and a lone 1.200 or 1,200 is the
+# one shape that is ambiguous (see `read_numbers`).
+_NUMBER = re.compile(r"""
+    (?P<ratio>(?<![\d.,])(?P<a>\d+(?:[.,]\d+)?)(?:\s?[:/\u2236]\s?|\s+in\s+)(?P<b>\d+(?:[.,]\d+)?)(?![\d]))
+  | (?P<nof>(?P<n>\d+)\s?(?:\u5206\u306e|\u5206\u4e4b|\ubd84\uc758)\s?(?P<m>\d+))
+  | (?P<eu>\d{1,3}(?:\.\d{3})+,\d+)
+  | (?P<en>\d{1,3}(?:,\d{3})+\.\d+)
+  | (?P<in>\d{1,2}(?:,\d{2})+,\d{3}(?:\.\d+)?)
+  | (?P<sp>\d{1,3}(?:[ \u00a0\u202f]\d{3})+(?:[.,]\d+)?)(?!\d)
+  | (?P<g>\d{1,3}(?:(?P<gm>[.,])\d{3})+)(?!\d)
+  | (?P<d>\d+(?:[.,]\d+)?)
+""", re.X)
+
+
+def read_numbers(text, parts=False):
+    """The numbers `text` STATES, each as the set of readings it can have -- compared as numbers.
+
+    WHY THIS EXISTS (T-008). The guard on `claimed_value` asked whether the digit RUNS of the claimed
+    value occurred as substrings of `normalise_quote(quote)`, which has already deleted every
+    separator. So 12 passed under "no higher than 1.2 m", 0.6 under "6.0 s", 1:1 and 112 under "1:12":
+    a figure with a shifted decimal point or a dropped colon rode in under a quote that verified.
+    The numbers have to be read BEFORE the punctuation is removed, which is why this sits beside
+    `normalise_quote` and does not reuse it.
+
+    Returns a list with one frozenset per number found, in order; a reading is (kind, Fraction),
+    kind "n" for a plain number and "r" for a RATIO (1:12, 1/12, 1 in 12, and the CJK/Korean n-th-part
+    form 12分の1), which is ONE number, the quotient, and is matched only by another ratio. A sign is
+    not read: magnitudes are compared. The only token with two readings is a lone group of exactly
+    three digits after a mark (1.200, 1,200): one point two, or twelve hundred. In a quote that is
+    the source's own typography and both stand; in a claimed value the caller refuses it and asks for
+    the unambiguous form (len(reading) > 1), because it is not ours to guess.
+
+    `parts=True` is for the QUOTE side only: a ratio's two operands, and the pieces of a space-grouped
+    number, are ALSO stated numbers ("AS 1428.1:2021" is a standard and a year, "800 750" is two
+    widths in a table, and neither is 1428.1/2021 or 800750). The claimed side never takes parts.
+
+    CJK numerals are NOT converted here: the caller that reads Japanese has `_cjk_to_arabic`.
+    """
+    from fractions import Fraction
+
+    def dec(t):                                   # "1,2" and "1.2" are both one point two
+        return Fraction(t.replace(",", "."))
+
+    out = []
+    for m in _NUMBER.finditer(unicodedata.normalize("NFKC", _TAG.sub(" ", text or ""))):
+        t = m.group(0)
+        if m.group("ratio") or m.group("nof"):
+            a, b = ((dec(m.group("a")), dec(m.group("b"))) if m.group("ratio")
+                    else (Fraction(m.group("m")), Fraction(m.group("n"))))
+            if b:
+                out.append(frozenset({("r", a / b)}))
+            out.extend(frozenset({("n", x)}) for x in (a, b) if parts)
+        elif m.group("eu"):
+            out.append(frozenset({("n", dec(t.replace(".", "")))}))
+        elif m.group("en") or m.group("in"):
+            out.append(frozenset({("n", Fraction(t.replace(",", "")))}))
+        elif m.group("sp"):
+            out.append(frozenset({("n", dec(re.sub(r"[ \u00a0\u202f]", "", t)))}))
+            if parts:
+                out.extend(frozenset({("n", dec(x))}) for x in re.split(r"[ \u00a0\u202f]", t))
+        elif m.group("g"):
+            grouped = Fraction(re.sub(r"[.,]", "", t))
+            lone = len(re.findall(r"[.,]", t)) == 1 and not t.startswith("0")
+            out.append(frozenset({("n", grouped), ("n", dec(t))}) if lone
+                       else frozenset({("n", dec(t))}) if t.startswith("0") else frozenset({("n", grouped)}))
+        else:
+            out.append(frozenset({("n", dec(t))}))
+    return out
+
+
 _XMLDECL_RE = re.compile(rb"""<\?xml[^>]{0,200}?encoding\s*=\s*["']([A-Za-z0-9_.:\-]+)["']""",
                          re.I)
 _CHARSET_RE = re.compile(rb"""charset\s*=\s*["']?([A-Za-z0-9_.:\-]+)""", re.I)
