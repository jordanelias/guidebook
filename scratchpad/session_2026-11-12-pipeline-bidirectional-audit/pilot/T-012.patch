+    t12_closed = [attempt(resolve_fu, t.get("follow_up_id"), "fixture: TASK-FIXTURE closed", S)
+                  for t in t12]
+    record("T012-02", "each new reason writes an open follow-up, a second open one of the "
+           "same reason is refused, and resolve-follow-up closes each",
+           all(t.get("follow_up_id") for t in t12)
+           and t12_again and "already has open" in t12_again
+           and all(c.get("resolved") is True for c in t12_closed),
+           f"{t12} {t12_again} {t12_closed}")
