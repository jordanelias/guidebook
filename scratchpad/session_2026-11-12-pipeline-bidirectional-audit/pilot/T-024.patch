+def add_jurisdiction(code: str, kind: str, approval_ref: str, session: str,
+                     parent: str = None, dry_run: bool = False):
+    """Admit one jurisdiction code to `base_jurisdictions` (migration 126). Before it, a code was
+    admitted by editing an enum in code. REFUSES: a blank or non-upper-case code; a `GB`-prefixed one
+    (the project writes UK, governance/jurisdiction-philosophy.md 3.3); a code already held; a kind
+    outside the column's CHECK; a parent on a non-sub-national code, or none on a sub-national one;
+    a parent that is not a held country/meta code, or that the sub-national code does not start with
+    (ISO 3166-2: AU-NSW under AU); an --approval-ref that is not the dated `## ` heading of exactly
+    one ledger entry (the pattern mint-term-from-catalogue uses; the entry's content is not read)."""
+    code = (code or "").strip()
+    parent = (parent or "").strip() or None
+    approval_ref = re.sub(r"^##\s+", "", (approval_ref or "").strip())
+    if not code or code != code.upper():
+        raise Refusal(f"add-jurisdiction: --code {code!r} must be non-blank and upper case.")
+    if code.startswith("GB"):
+        raise Refusal(f"add-jurisdiction: --code {code!r} is GB-prefixed; the project writes UK "
+                      f"(governance/jurisdiction-philosophy.md 3.3), e.g. UK-ENG. Nothing was written.")
+    if not re.search(r"\d{4}-\d{2}-\d{2}", approval_ref):
+        raise Refusal(f"add-jurisdiction: --approval-ref {approval_ref!r} carries no date. Give the "
+                      f"dated `## ` heading of the ledger entry that records the admission.")
+    n = dbcore.ledger_heading_count(approval_ref)
+    if n != 1:
+        raise Refusal(
+            f"add-jurisdiction: --approval-ref {approval_ref!r} is the heading of {n} ledger entries; "
+            f"it must be exactly one. Record the admission in a dated entry of "
+            f"references/project-standards.md first (CLAUDE.md rule 0), then give its heading as written.")
+    with connect(dry_run) as conn:
+        dbcore.check_declared(conn, "base_jurisdictions", "kind", kind, "add-jurisdiction --kind")
+        if dbcore.exists(conn, "base_jurisdictions", "jurisdiction_code", code):
+            raise Refusal(f"add-jurisdiction: {code!r} is already declared. Nothing was written.")
+        if (kind == "sub-national") != (parent is not None):
+            raise Refusal("add-jurisdiction: --parent is required for kind sub-national and refused for "
+                          "any other kind. Nothing was written.")
+        if parent is not None:
+            held = conn.execute("SELECT kind FROM base_jurisdictions WHERE jurisdiction_code=?",
+                                (parent,)).fetchone()
+            if held is None or held["kind"] == "sub-national":
+                raise Refusal(f"add-jurisdiction: --parent {parent!r} is not a declared country code. "
+                              f"Nothing was written.")
+            if not code.startswith(parent + "-"):
+                raise Refusal(f"add-jurisdiction: a sub-national code under {parent!r} is written "
+                              f"'{parent}-XXX' (ISO 3166-2, UK prefix for the United Kingdom); got "
+                              f"{code!r}. Nothing was written.")
+        row = {"jurisdiction_code": code, "kind": kind, "parent_code": parent,
+               "admission_ref": approval_ref}
+        row.update(dbcore.stamp_for(conn, "base_jurisdictions", session))
+        conn.execute(f"INSERT INTO base_jurisdictions ({','.join(row)}) "
+                     f"VALUES ({','.join('?' * len(row))})", list(row.values()))
+        return {"jurisdiction_code": code, "kind": kind, "parent_code": parent, "dry_run": dry_run}
