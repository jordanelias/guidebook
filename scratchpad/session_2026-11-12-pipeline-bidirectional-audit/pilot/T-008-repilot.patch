+def _require_claimed_number(text, claimed_value, claim_type, value_as_written, field, context):
+    """The claimed figure must be a number the quote states -- compared as NUMBERS, not as digit runs.
+
+    A digit run found in a quote stripped of punctuation can sit across a decimal point or a colon
+    (12 "occurs" in 1.2 m; 1:1 in 1:12), so the quote is read for the numbers it states BEFORE its
+    punctuation goes (`retrieval_log.numbers_stated`; the CJK numerals are converted first, as
+    always). Per claimed token: a plain number must equal a number the quote states; a symbol ratio
+    must equal a symbol ratio the quote states, and where the quote states none (it writes the ratio
+    in words) each operand must be a number it states, each matched once. A claimed token that is
+    ambiguous (`1.200`) is refused; a quote token that is (`1,200` is 1.2 or 1200) is matched but
+    does not count as a numeral.
+
+    A FIGURE THE SOURCE WRITES IN WORDS is entered as its numeral (`--claimed-value 5
+    --claimed-unit %`), with the source's own wording in `--value-as-written` (owner, 2026-11-12:
+    "just translate these into numbers/units"). The column is REQUIRED exactly when some claimed
+    number is not stated as an unambiguous numeral, REFUSED otherwise (it is not for copying
+    numerals), and must occur in `claim_text` under the quote normalisation. THAT THE WORDING MEANS
+    THAT NUMBER IS THE EXTRACTOR'S JUDGMENT: the column and the row's session record it, and the
+    adversarial pass and a reviewer check it. No table of number words is kept here to check it by
+    machine, deliberately. A `claim_type` of `dbcore.QUANTITY_CLAIM_TYPES` (or none given) must
+    carry a number.
+    """
+    rl = _retrieval_log()
+    vaw = value_as_written
+    if vaw is not None and not str(vaw).strip():
+        raise Refusal(f"{context}: --value-as-written is blank. Leave it out, or give the source's "
+                      f"own wording of the figure. Nothing was written.")
+    claimed = rl.numbers_stated(claimed_value) if claimed_value else []
+    if not claimed:
+        if claimed_value and (claim_type is None or claim_type in dbcore.QUANTITY_CLAIM_TYPES):
+            raise Refusal(
+                f"{context}: claimed_value {claimed_value!r} contains no number, and a "
+                f"{claim_type or 'quantity'} figure is a number. Enter the numeral in "
+                f"--claimed-value and the unit in --claimed-unit, and give the source's own wording "
+                f"of it in --value-as-written (a figure written in words is filed as a numeral). "
+                f"Nothing was written.")
+        if vaw is not None:
+            raise Refusal(f"{context}: --value-as-written was given, but the claimed value states no "
+                          f"number for it to be the wording of. Nothing was written.")
+        return
+    if any(len(r) > 1 for _, r in claimed):
+        raise Refusal(
+            f"{context}: claimed_value {claimed_value!r} is ambiguous (a single group of three "
+            f"digits after one mark is a decimal or a thousands group). Write 1200 or 1.2. "
+            f"Nothing was written.")
+    stated = rl.numbers_stated(_cjk_to_arabic(text), quote=True)
+    pool = [r for k, r in stated if k == "n"]
+    ratios = [r for k, r in stated if k == "r"]
+    used = set()
+
+    def match(want, tokens, consume=False):
+        """"numeral" (an unambiguous token equals it), "ambiguous" (only an ambiguous one does), or None."""
+        hit = None
+        for n, r in enumerate(tokens):
+            if want in r and not (consume and n in used):
+                if len(r) == 1:
+                    used.add(n)
+                    return "numeral"
+                hit = hit or (n, "ambiguous")
+        if hit:
+            used.add(hit[0])
+            return hit[1]
+        return None
+
+    unstated = []
+    for kind, (reading,) in claimed:
+        if kind == "r" and ratios:
+            got = match(reading, ratios)
+        elif kind == "r":                       # the quote writes the ratio in words: operands, once each
+            got = [match(op, pool, consume=True) for op in reading]
+            got = "numeral" if got == ["numeral"] * 2 else (None if None in got else "ambiguous")
+        else:
+            got = match(reading, pool)
+        if got != "numeral":
+            unstated.append((kind, reading, got))
+    if not unstated:
+        if vaw is not None:
+            raise Refusal(
+                f"{context}: --value-as-written was given, but {claimed_value!r} is stated as a "
+                f"numeral in the {field}. The column holds the source's wording of a figure it does "
+                f"not state as a numeral; it is not for copying one. Nothing was written.")
+        return
+    shown = ", ".join(("ambiguous in the quote: " if g else "not in the quote: ")
+                      + (f"{r[0]}:{r[1]}" if k == "r" else str(r)) for k, r, g in unstated)
+    if vaw is None:
+        raise Refusal(
+            f"{context}: claimed_value {claimed_value!r} is not stated as a numeral in the verified "
+            f"{field} ({shown}). A number attached to a quote rather than read from one is the "
+            f"2026-08-19 fabrication shape with a figure in place of an author. If the source "
+            f"writes the figure in words, or only ambiguously (1,200), pass its own wording in "
+            f"--value-as-written; otherwise quote the sentence that states the value. "
+            f"Nothing was written.")
+    if not rl.normalise_quote(vaw) or not rl.phrase_in_quote(vaw, text):
+        raise Refusal(
+            f"{context}: --value-as-written {vaw!r} does not occur in the {field}. It is the "
+            f"source's own wording of the figure, as it stands in the quote. Nothing was written.")
 
 
