+# --- the numbers a text states ------------------------------------------------------------------
+# `normalise_quote` deletes punctuation, so a digit run found in its output can sit across a
+# decimal point or a colon: 12 "occurs" in 1.2 m, 1:1 in 1:12. This reads the numbers BEFORE the
+# punctuation goes. No word of any language is listed here: a figure written in words has no
+# reading, and `db._require_verbatim` asks the extractor for the numeral and the source's wording.
+_UNGROUPED = r"\d+(?:[.,]\d+)?"
+_RUN = r"\d+(?:[.,]\d+| \d{3}(?!\d))*"
+_NUMBERS = re.compile(rf"(?P<a>{_UNGROUPED})(?P<op>[:/\u2236\u2044])(?P<b>{_UNGROUPED})|(?P<n>{_RUN})")
+_THOUSANDS = r"\d{1,3}(?:[.,]\d{3})+"
+
+
+def _dec(s):
+    return Decimal(s.replace(",", "."))
+
+
+def _read_run(run):
+    """[(readings, is_piece)] for one digit run. `readings` is a tuple of Decimals, more than one
+    only for the ambiguous `1.200` / `1,200` (a decimal AND a grouped thousand)."""
+    if " " in run:
+        m = re.fullmatch(r"(\d{1,3})((?: \d{3})+)(?:[.,](\d+))?", run)
+        if m:
+            whole = Decimal(m[1] + m[2].replace(" ", "") + ("." + m[3] if m[3] else ""))
+            return [((whole,), False)] + [(r, True) for seg in run.split(" ") for r, _ in _read_run(seg)]
+        return [x for seg in run.split(" ") for x in _read_run(seg)]
+    if re.fullmatch(r"\d+", run):
+        return [((Decimal(run),), False)]
+    if re.fullmatch(r"\d{1,2}(?:,\d{2})+,\d{3}", run):                    # Indian grouping: 1,50,000
+        return [((Decimal(run.replace(",", "")),), False)]
+    m = re.fullmatch(r"(\d+)([.,])(\d+)", run)
+    if m:                                                                   # one mark
+        a, _, b = m.groups()
+        if len(b) == 3 and len(a) <= 3 and not a.startswith("0"):           # 1.200 : decimal or thousands
+            return [((_dec(run), Decimal(a + b)), False)]
+        return [((_dec(run),), False)]
+    if re.fullmatch(_THOUSANDS, run) and len(set(re.findall(r"[.,]", run))) == 1:   # 1.234.567
+        return [((Decimal(re.sub(r"[.,]", "", run)),), False)]
+    m = re.fullmatch(rf"({_THOUSANDS})([.,])(\d+)", run)
+    if m and m[2] not in m[1]:                                              # 1.234,56 and 1,234.56
+        return [((Decimal(re.sub(r"[.,]", "", m[1]) + "." + m[3]),), False)]
+    return [((_dec(x),), False) for x in re.findall(_UNGROUPED, run)]      # 12.03.2021 and the like
+
+
+def numbers_stated(text, quote=False):
+    """The number tokens `text` states, as [(kind, readings)]. kind is "n" (readings: Decimals) or
+    "r" (a symbol ratio 1:12, 1/12: readings are (Decimal, Decimal) pairs). A token with more than
+    one reading is AMBIGUOUS. Signs and units are not read. The caller converts CJK numerals first.
+    With `quote=True` the operands of a symbol ratio and the pieces of a space-grouped number are
+    also stated numbers (`AS 1428.1:2021` states 1428.1 and 2021; a cell `800 750` states 800 and
+    750); a claimed value is read without them."""
+    s = unicodedata.normalize("NFKC", _TAG.sub(" ", text or ""))
+    out = []
+    for m in _NUMBERS.finditer(s):
+        if m["op"]:
+            ra, rb = _read_run(m["a"])[0][0], _read_run(m["b"])[0][0]
+            out.append(("r", tuple((x, y) for x in ra for y in rb)))
+            if quote:
+                out += [("n", ra), ("n", rb)]
+        else:
+            for readings, piece in _read_run(m["n"]):
+                if quote or not piece:
+                    out.append(("n", readings))
+    return out
+
+
 _XMLDECL_RE = re.compile(rb"""<\?xml[^>]{0,200}?encoding\s*=\s*["']([A-Za-z0-9_.:\-]+)["']""",
                          re.I)
 _CHARSET_RE = re.compile(rb"""charset\s*=\s*["']?([A-Za-z0-9_.:\-]+)""", re.I)
