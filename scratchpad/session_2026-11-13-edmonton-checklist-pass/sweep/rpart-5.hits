scripts/migrations/057_baseline_2026-08-12.sql:1593:INSERT INTO "decisions" (rowid, "decision_id", "category", "delegation", "delegation_rationale", "summary", "outcome", "rationale", "decision_date", "decided_by", "model_routing", "effort_level", "status", "review_status", "supersedes", "predecessors", "decision_artifacts", "alternatives_considered", "notes", "created_at", "created_by_session", "updated_at", "updated_by_session") VALUES (2, 'D-0002', 'D-DOCT', 'DG-NON', NULL, 'Disability populations are not uniform', 'Disability populations are not uniform', 'Disability populations are not uniform. Every person within a population code has a unique experience and unique functional limitations, even where there is significant overlap with others who share the same condition. There are different ways to struggle with mobility, different ways to be blind, different ways to have MS, different ways to be autistic, different ways to have dementia, different ways to experience PTSD. There is no generic ideal for any population. Specifications provide ranges and starting points — not definitive answers. It is rare for a disability to be experienced in isolation; co-occurring conditions are the norm. Every item specification must acknowledge functional variability within the population and discuss how co-occurrence affects the design parameter, because that is the lived reality of the people the guidebook serves. Population codes are a high-level organizing principle: at Tier 0 they are comprehensive (mapping all considerations); at Tier 1 they offer insight (what to think about for a known population); at Tier 2 they step aside because a person is not defined by their disabilities — OT works bottom-up from functional impairments because everything must be uniquely tailored to the individual.', '2026-04-24 23:38', 'solo_author_pre_launch', 'legacy/none/none', 100, 'ACTIVE', 'NA', '[]', '[]', '["references/project-standards.md \u00a7Core Doctrine (locked)"]', '["(seeded record; original alternatives not captured at rule authoring; reviewable)"]', 'Seeded from project-standards.md §Core Doctrine (locked) at A12 Session 2 (2026-04-30 13:20). Classification heuristic; review pending.', '2026-08-04 19:55', 'session_2026-08-04-f3a-decision-register-import', '2026-08-04 19:55', 'session_2026-08-04-f3a-decision-register-import');
scripts/migrations/057_baseline_2026-08-12.sql:1595:INSERT INTO "decisions" (rowid, "decision_id", "category", "delegation", "delegation_rationale", "summary", "outcome", "rationale", "decision_date", "decided_by", "model_routing", "effort_level", "status", "review_status", "supersedes", "predecessors", "decision_artifacts", "alternatives_considered", "notes", "created_at", "created_by_session", "updated_at", "updated_by_session") VALUES (4, 'D-0004', 'D-DOCT', 'DG-NON', NULL, 'Evidence hierarchy is seven tiers', 'Evidence hierarchy is seven tiers', 'Evidence hierarchy is seven tiers. Tier 1 = OT intervention-tested clinical research; Co-1 = lived experience / participatory design (CRPD Art. 4.3, co-primary with Tier 1); Tier 2 = NGO/DPO/advocacy guidelines; Co-2 = OT professional body CPGs (CAOT, AOTA, RCOT, COTEC, WFOT); Tier 3 = systematic reviews and meta-analyses; Tier 4 = international standards with evidence basis; Tier 5 = national beyond-code frameworks; Tier 6 = statutory codes (reference baseline only). OT body guidelines = Tier 3 with [Tier 3 — CPG] marker. The evidence hierarchy determines what constitutes best practice. Codes (Tier 6) inform us in situations where nothing else can. Where higher-tier evidence exists, it governs.', '2026-03-19 19:00', 'solo_author_pre_launch', 'legacy/none/none', 100, 'ACTIVE', 'NA', '[]', '[]', '["references/project-standards.md \u00a7Core Doctrine (locked)"]', '["(seeded record; original alternatives not captured at rule authoring; reviewable)"]', 'Seeded from project-standards.md §Core Doctrine (locked) at A12 Session 2 (2026-04-30 13:20). Classification heuristic; review pending.', '2026-08-04 19:55', 'session_2026-08-04-f3a-decision-register-import', '2026-08-04 19:55', 'session_2026-08-04-f3a-decision-register-import');
scripts/migrations/057_baseline_2026-08-12.sql:1596:INSERT INTO "decisions" (rowid, "decision_id", "category", "delegation", "delegation_rationale", "summary", "outcome", "rationale", "decision_date", "decided_by", "model_routing", "effort_level", "status", "review_status", "supersedes", "predecessors", "decision_artifacts", "alternatives_considered", "notes", "created_at", "created_by_session", "updated_at", "updated_by_session") VALUES (5, 'D-0005', 'D-DOCT', 'DG-NON', NULL, 'Best practice means the most accommodating, thoughtful, respectful, dignified, and usable condition achievable for th...', 'Best practice means the most accommodating, thoughtful, respectful, dignified, and usable condition achievable for th...', 'Best practice means the most accommodating, thoughtful, respectful, dignified, and usable condition achievable for the disabled person. Best practice is determined by the evidence hierarchy — Tier 1 clinical research, Co-1 lived experience, Co-2 OT CPGs, Tier 3 systematic reviews — not by code consensus. Codes are Tier 6: the compliance floor, not the aspiration. Code consensus across jurisdictions establishes what most codes agree on; it does not establish what is most accommodating or most dignified. A BPC best_practice_synthesis that derives its value solely from code consensus is in error. The test: does this specification provide the most accommodating, dignified, usable condition the evidence supports — or does it merely reflect what codes agree on?', '2026-04-24 23:46', 'solo_author_pre_launch', 'legacy/none/none', 100, 'ACTIVE', 'NA', '[]', '[]', '["references/project-standards.md \u00a7Core Doctrine (locked)"]', '["(seeded record; original alternatives not captured at rule authoring; reviewable)"]', 'Seeded from project-standards.md §Core Doctrine (locked) at A12 Session 2 (2026-04-30 13:20). Classification heuristic; review pending.', '2026-08-04 19:55', 'session_2026-08-04-f3a-decision-register-import', '2026-08-04 19:55', 'session_2026-08-04-f3a-decision-register-import');
scripts/migrations/057_baseline_2026-08-12.sql:1622:INSERT INTO "decisions" (rowid, "decision_id", "category", "delegation", "delegation_rationale", "summary", "outcome", "rationale", "decision_date", "decided_by", "model_routing", "effort_level", "status", "review_status", "supersedes", "predecessors", "decision_artifacts", "alternatives_considered", "notes", "created_at", "created_by_session", "updated_at", "updated_by_session") VALUES (31, 'D-0031', 'D-DOCT', 'DG-NON', NULL, '24 jurisdictions canonical (per jurisdiction-tracker §4.7.3)', '24 jurisdictions canonical (per jurisdiction-tracker §4.7.3)', '24 jurisdictions canonical (per jurisdiction-tracker §4.7.3). Language and jurisdiction coverage are distinct axes — both satisfied independently. Per-jurisdiction tier coverage record required: status (SEARCHED|THIN|NO-DATA|NOT-RUN), co1_attempted, tier5_attempted, tier6_attempted. Pre-LOG completeness check mandatory (24 jurisdictions, co1_pass_summary, best_practice_synthesis, citation_mining, native_aliases for 14 languages) — fail = BLOCKER. BPC entry PROVISIONAL until all 24 recorded + co1_pass ≥9 languages.', '2026-03-19 19:28', 'solo_author_pre_launch', 'legacy/none/none', 100, 'ACTIVE', 'NA', '[]', '[]', '["references/project-standards.md \u00a7Research and Evidence Pipeline"]', '["(seeded record; original alternatives not captured at rule authoring; reviewable)"]', 'Seeded from project-standards.md §Research and Evidence Pipeline at A12 Session 2 (2026-04-30 13:20). Classification heuristic; review pending.', '2026-08-04 19:55', 'session_2026-08-04-f3a-decision-register-import', '2026-08-04 19:55', 'session_2026-08-04-f3a-decision-register-import');
scripts/migrations/057_baseline_2026-08-12.sql:1627:INSERT INTO "decisions" (rowid, "decision_id", "category", "delegation", "delegation_rationale", "summary", "outcome", "rationale", "decision_date", "decided_by", "model_routing", "effort_level", "status", "review_status", "supersedes", "predecessors", "decision_artifacts", "alternatives_considered", "notes", "created_at", "created_by_session", "updated_at", "updated_by_session") VALUES (36, 'D-0036', 'D-METH', 'DG-NON', NULL, 'Evidence Priority: BPC best_practice_synthesis governs as primary evidence basis', 'Evidence Priority: BPC best_practice_synthesis governs as primary evidence basis', 'Evidence Priority: BPC best_practice_synthesis governs as primary evidence basis. Raw search results supplement but never override. Contradictions → evidence-auditor.', '2026-03-27 14:00', 'solo_author_pre_launch', 'legacy/none/none', 100, 'ACTIVE', 'NA', '[]', '[]', '["references/project-standards.md \u00a7Endnote and Source Pipeline"]', '[]', 'Seeded from project-standards.md §Endnote and Source Pipeline at A12 Session 2 (2026-04-30 13:20). Classification heuristic; review pending.', '2026-08-04 19:55', 'session_2026-08-04-f3a-decision-register-import', '2026-08-04 19:55', 'session_2026-08-04-f3a-decision-register-import');
scripts/migrations/057_baseline_2026-08-12.sql:1633:INSERT INTO "decisions" (rowid, "decision_id", "category", "delegation", "delegation_rationale", "summary", "outcome", "rationale", "decision_date", "decided_by", "model_routing", "effort_level", "status", "review_status", "supersedes", "predecessors", "decision_artifacts", "alternatives_considered", "notes", "created_at", "created_by_session", "updated_at", "updated_by_session") VALUES (42, 'D-0042', 'D-DOCT', 'DG-NON', NULL, 'Specification language is tier-appropriate and does not claim authority the project does not have', 'Specification language is tier-appropriate and does not claim authority the project does not have', 'Specification language is tier-appropriate and does not claim authority the project does not have. The guidebook is an advocacy project (see Core Doctrine), not a standard-setting body. Specification constructions by tier: Tier 0 — "Code requires [value] per [standard]" (authority is the code, not the guidebook). Tier 1 — "[Evidence tier] evidence supports [value]" or "Best practice based on [N] jurisdictions and [tier] evidence is [value]" (authority is the evidence). Tier 2 — "OT assessment determines position within [range] based on [functional parameter]" (authority is the OT). The former convention of blanket "shall be" constructions is retired — "shall be" implies mandating authority the project does not possess. Always run prose-style-checker before vol2-item-formatter. Existing Part 4 text using "shall be" requires a voice pass (A4 or C-stage find-and-replace).', '2026-04-26 19:25', 'solo_author_pre_launch', 'legacy/none/none', 100, 'ACTIVE', 'NA', '[]', '[]', '["references/project-standards.md \u00a7Specification Process Rules"]', '["(seeded record; original alternatives not captured at rule authoring; reviewable)"]', 'Seeded from project-standards.md §Specification Process Rules at A12 Session 2 (2026-04-30 13:20). Classification heuristic; review pending.', '2026-08-04 19:55', 'session_2026-08-04-f3a-decision-register-import', '2026-08-04 19:55', 'session_2026-08-04-f3a-decision-register-import');
scripts/migrations/057_baseline_2026-08-12.sql:1667:INSERT INTO "decisions" (rowid, "decision_id", "category", "delegation", "delegation_rationale", "summary", "outcome", "rationale", "decision_date", "decided_by", "model_routing", "effort_level", "status", "review_status", "supersedes", "predecessors", "decision_artifacts", "alternatives_considered", "notes", "created_at", "created_by_session", "updated_at", "updated_by_session") VALUES (76, 'D-0076', 'D-METH', 'DG-NON', NULL, 'Thermoregulation-impaired populations require a narrower ambient temperature range than general accessible building s...', 'Thermoregulation-impaired populations require a narrower ambient temperature range than general accessible building s...', 'Thermoregulation-impaired populations require a narrower ambient temperature range than general accessible building standards. Working target: 18–22°C. Floor: 18°C (WHO minimum; FMS cold threshold). Ceiling: 22°C (MS Uhthoff onset; SCI heat risk begins). Above 24°C exceeds WHO vulnerable individual threshold — not acceptable for thermoregulation-impaired occupants at rest. Condition for application: Any specification, conflict resolution, or design guidance involving indoor thermal environment for NEU (MS, SCI), OFS (POTS, MCAS), or PAIN (FMS) populations. Required action: Apply 18–22°C as the working target range. Flag it as derived from clinical evidence synthesis, not from any single accessible building standard or OT CPG (none addresses this specifically).', '2026-04-07 00:22', 'solo_author_pre_launch', 'legacy/none/none', 100, 'ACTIVE', 'NA', '[]', '[]', '["references/project-standards.md \u00a7Session 2026-04-07 \u2014 Phase 1-A thermoregulation-built-environment"]', '[]', 'Seeded from project-standards.md §Session 2026-04-07 — Phase 1-A thermoregulation-built-environment at A12 Session 2 (2026-04-30 13:20). Classification heuristic; review pending.', '2026-08-04 19:55', 'session_2026-08-04-f3a-decision-register-import', '2026-08-04 19:55', 'session_2026-08-04-f3a-decision-register-import');
scripts/migrations/057_baseline_2026-08-12.sql:1696:INSERT INTO "decisions" (rowid, "decision_id", "category", "delegation", "delegation_rationale", "summary", "outcome", "rationale", "decision_date", "decided_by", "model_routing", "effort_level", "status", "review_status", "supersedes", "predecessors", "decision_artifacts", "alternatives_considered", "notes", "created_at", "created_by_session", "updated_at", "updated_by_session") VALUES (105, 'D-0105', 'D-DOCT', 'DG-NON', NULL, 'A12 decision-protocol.md is CANONICAL', 'A12 decision-protocol.md is CANONICAL', 'A12 decision-protocol.md is CANONICAL. Governs: 5 decision categories (D-DOCT doctrinal, D-METH methodological, D-SCHEMA schema, D-OP operational, D-PRES presentation); 3 delegation categories (DG-NON non-delegable, DG-REVIEW delegable-with-review, DG-AUTO automatic) with category-default delegation table and 10 always-DG-NON decision types named explicitly (mission/CRPD; population taxonomy; evidence-tier definitions; jurisdiction inclusion; major work-products; Co-1 corpus; licensing per A11 §4; trajectory per A11 §5; misuse-vector retirement per A10 §5.4; counsel-queue resolution per A11 §6); 16-field capture protocol with §3.3 rationale-length norms per category and §3.4 three rationale anti-patterns (tautology, authority-without-content, outcome-as-rationale); standardised model-routing notation `{tier}/{effort}/{modifier}` resolving L-05 (deprecates "Opus session", "best-practice synthesis", and other ad hoc forms); decision register at data/decisions/decision_register.yaml (legacy workplan/v10-1-decision-register.md superseded); CS8 cross-stage activation — every new RULE in project-standards pairs with a Decision record from this point forward. Schema: decision.py (new), enums.py (+4 enums: DecisionCategory, DelegationCategory, DecisionStatus, DecisionReviewStatus). Validator: decision_capture.py (8 checks C1-C8; CLI --register-only / --decision-id / --report). Sessions remaining in A12: Session 2 (seeding extraction ~80-120 records + session-consolidator wiring + C7 tightening); Sessions 3-4 (armature presentation-layer expansion: role-based content variants, plain-language register, variable conflation, etc).', '2026-04-30 02:55', 'solo_author_pre_launch', 'legacy/none/none', 100, 'ACTIVE', 'NA', '[]', '[]', '["governance/decision-protocol.md", "references/project-standards.md \u00a7Session 2026-04-29 \u2014 A6 Evidence Methodology"]', '["(seeded record; original alternatives not captured at rule authoring; reviewable)"]', 'Seeded from project-standards.md §Session 2026-04-29 — A6 Evidence Methodology at A12 Session 2 (2026-04-30 13:20). Classification heuristic; review pending.', '2026-08-04 19:55', 'session_2026-08-04-f3a-decision-register-import', '2026-08-04 19:55', 'session_2026-08-04-f3a-decision-register-import');
scripts/migrations/057_baseline_2026-08-12.sql:1713:', '2026-05-01 03:50', 'opus_4_7_session_2026-05-01', 'opus/150/synth', 150, 'ACTIVE', 'PENDING', '[]', '["D-0108"]', '["workplan/b1-criteria-weighting.md \u00a73.5", "sessions/session_2026-05-01-b1-s2.md", "data/decisions/decision_register.yaml"]', '["Weighted partial scoring (candidate scores 0\u20135 on the deliverables, with weighted sum) \u2014 rejected: invites the trap where a 4/5 candidate looks comparable to 5/5 but the missing deliverable is the binding-constraint one. Binary pass/fail forces the candidate to satisfy all five.", "Less stringent 3-deliverable standard (full export + relationship preservation + schema mapping) \u2014 rejected: state preservation is not optional. A candidate that exports records but loses verification statuses or state-machine values traps the synthesis work; the project''s epistemic commitments live in those states.", "More stringent (lossless re-import required for all three other candidates) \u2014 rejected: lossless re-import across substrate boundaries (e.g., relational \u2192 graph \u2192 markdown) is not generally achievable; requiring it would dismiss all four candidates by construction. Documented losses are sufficient.", "No 2-session budget cap on export tooling (any tooling cost acceptable as long as documented) \u2014 rejected: a candidate whose export tooling would take 8 sessions to write has effectively unbounded migration-out cost relative to the project''s session economics. The 2-session bound matches the scale of Stage A converters, which is the empirical reference for \"tractable converter complexity.\""]', 'Operationalizes criterion C-10.3 (migration-out cost bounded). C-10.3 holds weight 2 under D-0110 because S-05 is binding under S-05 itself (the requirement is doctrinally privileged insofar as the project''s resolution principle of "clean data + transparent methodology" requires that the corpus not be trapped in a chosen storage form). Sessions 3–6 evaluate each candidate against the five deliverables; the schema mapping document of §4 is itself a deliverable artifact each candidate produces during its evaluation session.
scripts/migrations/057_baseline_2026-08-12.sql:1784:', '2026-05-02 02:35', 'opus_4_7_session_2026-05-02', 'opus/150/synth', 150, 'ACTIVE', 'PENDING', '[]', '["D-0108", "D-0110", "D-0136"]', '["workplan/b1-comparative-scoring.md \u00a73.3", "sessions/session_2026-05-02-b1-s7.md", "data/decisions/decision_register.yaml"]', '["Rule 1 (highest weighted total wins \u2192 C) \u2014 rejected: collapses the selection question into a numeric comparison; ignores doctrinal binding force beyond what weights captured; selects C by a 3-point margin (1.7% of max) which is at the noise floor of weighting precision.", "Rule 2 (highest weighted total subject to doctrinal-anchor constraint \u2192 C, since none of three fails a weight-3 criterion at score < 2) \u2014 rejected: same outcome as Rule 1 because the constraint is non-binding; the doctrinal anchors require structured reasoning, not pass/fail filtering.", "Rule 4 (lowest cost-to-native subject to acceptable score threshold \u2192 A if threshold is 75%, B if threshold is 88%) \u2014 rejected: threshold selection is itself arbitrary without further reasoning; Rule 3 incorporates cost as one consideration among others rather than as a binary filter.", "Defer rule selection to Session 8 alongside the selection itself \u2014 rejected: bundling the rule choice with the selection conflates methodology with outcome; explicit rule commitment in Session 7 makes Session 8''s reasoning auditable against a stated rule."]', 'DG-REVIEW because the selection decision rule constrains Session 8''s reasoning structure. Project-owner review confirms Rule 3 is the appropriate frame for the final selection. If review surfaces concerns, the rule can be amended before Session 8 commits to a candidate.
scripts/migrations/057_baseline_2026-08-12.sql:5715:INSERT INTO "source_locators" (rowid, "ref_id", "doi", "url", "pmid", "pmcid", "isbn", "issn", "standard_number", "doi_resolution_outcome", "url_resolution_outcome", "url_last_fetched", "recovered_from") VALUES (35, 'REF-00039', NULL, 'https://www.deafblindinternational.org/', NULL, NULL, NULL, NULL, 'DbI Best Practice Guidelines; companion CBM 2022 guidelines developed with WFDB, DbI, Perkins International, Sense International, Royal Dutch Visio', NULL, NULL, NULL, 'corpus-pre-reset-2026-08-06');
scripts/migrations/057_baseline_2026-08-12.sql:6029:INSERT INTO "source_locators" (rowid, "ref_id", "doi", "url", "pmid", "pmcid", "isbn", "issn", "standard_number", "doi_resolution_outcome", "url_resolution_outcome", "url_last_fetched", "recovered_from") VALUES (349, 'REF-00376', NULL, 'https://www.iwa.ie/', NULL, NULL, NULL, NULL, 'Best Practice Access Guidelines (originally launched July 2014; ongoing revisions); companion The Great Outdoors: A Guide to Accessibility', NULL, NULL, NULL, 'corpus-pre-reset-2026-08-06');
scripts/migrations/057_baseline_2026-08-12.sql:6171:INSERT INTO "source_locators" (rowid, "ref_id", "doi", "url", "pmid", "pmcid", "isbn", "issn", "standard_number", "doi_resolution_outcome", "url_resolution_outcome", "url_last_fetched", "recovered_from") VALUES (491, 'REF-00531', NULL, 'https://accessible.canada.ca/creating-accessibility-standards/can-asc-24-wayfinding-and-signage/10-general-requirements-lighting-and-contrast', NULL, NULL, NULL, NULL, 'CAN-ASC-2.4 Wayfinding and Signage (Accessibility Standards Canada) clause 10 General requirements for lighting and contrast — Table 1 minimum luminance contrast values for matte surfaces; large surfaces ≥40 LRV light surface + ≥30% Michelson + ≥45% Weber; hazards ≥50 LRV + ≥60% Michelson + ≥75% Weber; text ≥70 LRV + ≥60% Michelson + ≥75% Weber. Companion standards: BS 8300-2:2018 Code of practice (UK 30-point LRV minimum); AS 1428.1:2009 + AS 1428.4.1:2009 (Australia 30% luminance contrast minimum via Bowman-Sapolinski equation Y1-Y2). Underlying: Accessible Canada Act (S.C. 2019, c. 10) + UK Equality Act 2010 + Australia DDA + AS/NZS framework. Argument: 30% is regulatory FLOOR, not functional optimum — Canadian Museum for Human Rights (CMHR) Inclusive and Accessible Design Guidelines uses 70% LRV difference for text legibility as best practice.', NULL, NULL, NULL, 'corpus-pre-reset-2026-08-06');
