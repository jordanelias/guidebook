-- 5. rebuild IN PLACE: one taxonomy column becomes four nullable typed FK
--    columns, a CHECK, and a STORED coalesce. Every original CHECK and every
--    named index is carried across explicitly -- PRAGMA table_info carries
--    neither, and dbcore.check_values() reads the column's own CHECK, so a
--    lost CHECK silently disarms every db.py refusal while it still looks safe.

CREATE TABLE "synthesis_items__065" (
  "slug" TEXT,
  "last_updated" TEXT,
  "jurisdictions_searched" INTEGER DEFAULT 0,
  "co1_pass_count" INTEGER DEFAULT 0,
  "evidence_state" TEXT,
  "pico_complete" INTEGER NOT NULL DEFAULT 0,
  "search_complete" INTEGER NOT NULL DEFAULT 0,
  "bpc_complete" INTEGER NOT NULL DEFAULT 0,
  "citation_mining_complete" INTEGER NOT NULL DEFAULT 0,
  "created_at" TEXT NOT NULL,
  "created_by_session" TEXT NOT NULL,
  "updated_at" TEXT NOT NULL,
  "updated_by_session" TEXT NOT NULL,
  "supersession_check_complete" INTEGER NOT NULL DEFAULT 0,
  "closure_definition_version" TEXT,
  "identity_code" TEXT REFERENCES "base_taxonomy_identity"("code"),
  "icf_code" TEXT REFERENCES "base_taxonomy_icf"("code"),
  "needs_code" TEXT REFERENCES "base_taxonomy_needs"("code"),
  "medical_code" TEXT REFERENCES "base_taxonomy_medical"("code"),
  "taxonomy_code" TEXT GENERATED ALWAYS AS (COALESCE("identity_code","icf_code","needs_code","medical_code")) STORED,
  PRIMARY KEY ("slug"),
  FOREIGN KEY ("slug") REFERENCES "base_slugs"("slug"),
  CHECK (pico_complete IN (0,1)),
  CHECK (search_complete IN (0,1)),
  CHECK (bpc_complete IN (0,1)),
  CHECK (citation_mining_complete IN (0,1)),
  CHECK (supersession_check_complete IN (0, 1)),
  CHECK (closure_definition_version IS NULL OR closure_definition_version IN ('v1', 'v2')),
  CHECK ((identity_code IS NOT NULL) + (icf_code IS NOT NULL)
       + (needs_code IS NOT NULL) + (medical_code IS NOT NULL) = 1)
);
INSERT INTO "synthesis_items__065" ("slug", "last_updated", "jurisdictions_searched", "co1_pass_count", "evidence_state", "pico_complete", "search_complete", "bpc_complete", "citation_mining_complete", "created_at", "created_by_session", "updated_at", "updated_by_session", "supersession_check_complete", "closure_definition_version", "identity_code") SELECT "slug", "last_updated", "jurisdictions_searched", "co1_pass_count", "evidence_state", "pico_complete", "search_complete", "bpc_complete", "citation_mining_complete", "created_at", "created_by_session", "updated_at", "updated_by_session", "supersession_check_complete", "closure_definition_version", "population" FROM "synthesis_items";
DROP TABLE "synthesis_items";
ALTER TABLE "synthesis_items__065" RENAME TO "synthesis_items";

CREATE TABLE "render_case_studies__065" (
  "case_study_id" TEXT NOT NULL,
  "slug" TEXT NOT NULL,
  "title" TEXT NOT NULL,
  "building_type" TEXT NOT NULL,
  "location" TEXT NOT NULL,
  "architect" TEXT,
  "year" INTEGER,
  "setting" TEXT,
  "participant_description" TEXT,
  "evidence_quality_tier" INTEGER,
  "cost_data" TEXT,
  "cost_data_quality" TEXT,
  "part_section" TEXT,
  "limitations" TEXT,
  "harm_finding" INTEGER NOT NULL DEFAULT 0,
  "status" TEXT NOT NULL DEFAULT 'active',
  "notes" TEXT,
  "created_at" TEXT NOT NULL,
  "created_by_session" TEXT NOT NULL,
  "updated_at" TEXT,
  "updated_by_session" TEXT,
  "design_intent" TEXT,
  "outcome_data" TEXT,
  "conflict_documented" TEXT,
  "failure_notes" TEXT,
  "construction_cost" TEXT,
  "accessible_design_premium" TEXT,
  "funding_sources" TEXT,
  "operational_cost_change" TEXT,
  "remediation_cost" TEXT,
  "roi_data" TEXT,
  "financial_evidence_tier" INTEGER,
  "financial_data_quality" TEXT,
  "evidence_contribution" TEXT,
  "part13_status" TEXT,
  "sources" TEXT,
  "identity_code" TEXT REFERENCES "base_taxonomy_identity"("code"),
  "icf_code" TEXT REFERENCES "base_taxonomy_icf"("code"),
  "needs_code" TEXT REFERENCES "base_taxonomy_needs"("code"),
  "medical_code" TEXT REFERENCES "base_taxonomy_medical"("code"),
  "taxonomy_code" TEXT GENERATED ALWAYS AS (COALESCE("identity_code","icf_code","needs_code","medical_code")) STORED,
  PRIMARY KEY ("case_study_id"),
  FOREIGN KEY ("slug") REFERENCES "base_slugs"("slug"),
  CHECK (evidence_quality_tier IS NULL
                                        OR evidence_quality_tier BETWEEN 1 AND 3),
  CHECK (cost_data_quality IS NULL OR cost_data_quality IN
                     ('VERIFIED','PROVISIONAL','GREY')),
  CHECK (harm_finding IN (0,1)),
  CHECK ((identity_code IS NOT NULL) + (icf_code IS NOT NULL)
       + (needs_code IS NOT NULL) + (medical_code IS NOT NULL) <= 1)
);
INSERT INTO "render_case_studies__065" ("case_study_id", "slug", "title", "building_type", "location", "architect", "year", "setting", "participant_description", "evidence_quality_tier", "cost_data", "cost_data_quality", "part_section", "limitations", "harm_finding", "status", "notes", "created_at", "created_by_session", "updated_at", "updated_by_session", "design_intent", "outcome_data", "conflict_documented", "failure_notes", "construction_cost", "accessible_design_premium", "funding_sources", "operational_cost_change", "remediation_cost", "roi_data", "financial_evidence_tier", "financial_data_quality", "evidence_contribution", "part13_status", "sources") SELECT "case_study_id", "slug", "title", "building_type", "location", "architect", "year", "setting", "population_description", "evidence_quality_tier", "cost_data", "cost_data_quality", "part_section", "limitations", "harm_finding", "status", "notes", "created_at", "created_by_session", "updated_at", "updated_by_session", "design_intent", "outcome_data", "conflict_documented", "failure_notes", "construction_cost", "accessible_design_premium", "funding_sources", "operational_cost_change", "remediation_cost", "roi_data", "financial_evidence_tier", "financial_data_quality", "evidence_contribution", "part13_status", "sources" FROM "render_case_studies";
