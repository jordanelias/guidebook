-- 065: seven-stage nomenclature + four lenses in one table.
--
-- AFTER_DATA: 20260827194239
--   This migration renames `decisions` to `base_decisions`, and the data
--   migration of that timestamp INSERTs into `decisions`. On a --rebuild the
--   runner replays every migration from the baseline, so without this marker the
--   rename would run first and the data step would fail on a table that no
--   longer exists. The marker is not paperwork: it is the only thing that keeps
--   `migrate_db.py --rebuild` reproducible, which is what CI compares against.
-- D-0167 spine | D-0168 hand-offs | D-0169 grammar | D-0170 four lenses |
-- D-0171 building | owner instruction 2026-08-28: all four lenses in the
-- same tables after the base phase, and loads of rows is fine.
--
-- Generated by scratchpad/session_2026-08-27-hook-audit/build_065.py.
-- Do not hand-edit: re-run the generator.
--
-- ORDER MATTERS, and the first draft had it wrong. RENAME COMES FIRST, then
-- the rebuilds happen IN PLACE under the new names. ALTER TABLE RENAME
-- repoints every inbound REFERENCES clause; DROP+CREATE does not. Rebuilding
-- case_studies before renaming it left three child tables pointing at a table
-- that no longer existed -- and PRAGMA foreign_key_check called it clean,
-- because all three hold 0 rows. Rule 4: a 0-row object is unproven, not clean.
--
-- WHAT IS DROPPED, AND ON WHAT EVIDENCE:
--   dual homes (rule 5 -- the link table is the pointer, the column the copy):
--     spec_value_probes.population        + probe_population_links
--     reasoning_doc_citations.population  + citation_population_links
--     source_value_extractions.population_code/_label + extraction_population_links
--     case_studies.populations_served_note + case_study_populations
--   measured 0-populated across every live row:
--     term_item_links.population            0 of 147
--     item_population_links.rationale_ref   0 of 372
--
-- NO LINK TABLE IS DROPPED. An earlier draft folded the five 0-row link
-- tables into their parents; that trades a many-to-many for one lens per
-- parent, which is a cardinality regression that 0 rows merely hides.
PRAGMA legacy_alter_table=OFF;

-- 1. the fourth lens needs an FK target. Empty: a medical vocabulary is
--    content doctrine (DG-NON) and is the owner's to write.
CREATE TABLE IF NOT EXISTS base_taxonomy_medical (
  code TEXT PRIMARY KEY,
  name TEXT NOT NULL,
  definition TEXT,
  created_at TEXT,
  created_by_session TEXT
);

-- 2. the three registries: rename table, then PK column to `code`.
--    RENAME COLUMN carries every inbound foreign key with it, and rewrites
--    view bodies -- measured on 3.45.1, and it correctly leaves a same-named
--    column on a DIFFERENT table alone.
ALTER TABLE "populations" RENAME TO "base_taxonomy_identity";
ALTER TABLE "base_taxonomy_identity" RENAME COLUMN "population_code" TO "code";
ALTER TABLE "axes" RENAME TO "base_taxonomy_icf";
ALTER TABLE "base_taxonomy_icf" RENAME COLUMN "axis_code" TO "code";
ALTER TABLE "access_needs" RENAME TO "base_taxonomy_needs";
ALTER TABLE "base_taxonomy_needs" RENAME COLUMN "need_code" TO "code";

-- 3. every remaining rename, INCLUDING the tables about to be rebuilt.
ALTER TABLE "access_duration" RENAME TO "base_access_duration";
