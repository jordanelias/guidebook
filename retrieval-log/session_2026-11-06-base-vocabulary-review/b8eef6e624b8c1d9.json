{"attached_files_info":null,"law_info":{"law_type":"MinisterialOrdinance","law_id":"418M60000800113","law_num":"平成十八年国土交通省令第百十三号","law_num_era":"Heisei","law_num_year":18,"law_num_type":"MinisterialOrdinance","law_num_num":"113","promulgation_date":"2006-12-15"},"revision_info":{"law_revision_id":"418M60000800113_20250601_506M60000800100","law_type":"MinisterialOrdinance","law_title":"高齢者、障害者等の移動等の円滑化の促進に関する法律施行令第二十条に規定する標識に関する省令","law_title_kana":"こうれいしゃしょうがいしゃとうのいどうとうのえんかつかのそくしんにかんするほうりつしこうれいだいにじゅうじょうにきていするひょうしきにかんするしょうれい","abbrev":"","category":"陸運","updated":"2025-02-14T08:37:09+09:00","amendment_promulgate_date":"2024-11-21","amendment_enforcement_date":"2025-06-01","amendment_enforcement_comment":null,"amendment_scheduled_enforcement_date":null,"amendment_law_id":"506M60000800100","amendment_law_title":"高齢者、障害者等の移動等の円滑化の促進に関する法律施行規則等の一部を改正する省令","amendment_law_title_kana":null,"amendment_law_num":"令和六年国土交通省令第百号","amendment_type":"3","repeal_status":"None","repeal_date":null,"remain_in_force":false,"mission":"New","current_revision_status":"CurrentEnforced"},"law_full_text":{"tag":"Law","attr":{"Lang":"ja","Era":"Heisei","Year":"18","Num":"113","PromulgateMonth":"12","PromulgateDay":"15","LawType":"MinisterialOrdinance"},"children":[{"tag":"LawNum","attr":{},"children":["平成十八年国土交通省令第百十三号"]},{"tag":"LawBody","attr":{},"children":[{"tag":"LawTitle","attr":{"Kana":"こうれいしゃしょうがいしゃとうのいどうとうのえんかつかのそくしんにかんするほうりつしこうれいだいにじゅうじょうにきていするひょうしきにかんするしょうれい","Abbrev":"","AbbrevKana":""},"children":["高齢者、障害者等の移動等の円滑化の促進に関する法律施行令第二十条に規定する標識に関する省令"]},{"tag":"EnactStatement","attr":{},"children":["高齢者、障害者等の移動等の円滑化の促進に関する法律施行令（平成十八年政令第三百七十九号）第十九条の規定に基づき、高齢者、障害者等の移動等の円滑化の促進に関する法律施行令第十九条に規定する標識に関する省令を次のように定める。"]},{"tag":"MainProvision","attr":{},"children":[{"tag":"Paragraph","attr":{"Num":"1"},"children":[{"tag":"ParagraphNum","attr":{},"children":["１"]},{"tag":"ParagraphSentence","attr":{},"children":[{"tag":"Sentence","attr":{"Num":"1","WritingMode":"vertical"},"children":["高齢者、障害者等の移動等の円滑化の促進に関する法律施行令第二十条に規定する標識は、高齢者、障害者等の見やすい位置に設けなければならない。"]}]}]},{"tag":"Paragraph","attr":{"Num":"2"},"children":[{"tag":"ParagraphNum","attr":{},"children":["２"]},{"tag":"ParagraphSentence","attr":{},"children":[{"tag":"Sentence","attr":{"Num":"1","WritingMode":"vertical"},"children":["前項の標識は、当該標識に表示すべき内容が容易に識別できるもの（当該内容が日本工業規格Ｚ八二一〇に定められているときは、これに適合するもの）でなければならない。"]}]}]}]},{"tag":"SupplProvision","attr":{},"children":[{"tag":"SupplProvisionLabel","attr":{},"children":["附　則"]},{"tag":"Paragraph","attr":{"Num":"1"},"children":[{"tag":"ParagraphNum","attr":{},"children":[]},{"tag":"ParagraphSentence","attr":{},"children":[{"tag":"Sentence","attr":{"Num":"1","WritingMode":"vertical"},"children":["この省令は、高齢者、障害者等の移動等の円滑化の促進に関する法律（平成十八年法律第九十一号）の施行の日（平成十八年十二月二十日）から施行する。"]}]}]}]},{"tag":"SupplProvision","attr":{"AmendLawNum":"令和六年一一月二一日国土交通省令第一〇〇号","Extract":"true"},"children":[{"tag":"SupplProvisionLabel","attr":{},"children":["附　則"]},{"tag":"Article","attr":{"Num":"1"},"children":[{"tag":"ArticleCaption","attr":{},"children":["（施行期日）"]},{"tag":"ArticleTitle","attr":{},"children":["第一条"]},{"tag":"Paragraph","attr":{"Num":"1"},"children":[{"tag":"ParagraphNum","attr":{},"children":[]},{"tag":"ParagraphSentence","attr":{},"children":[{"tag":"Sentence","attr":{"Num":"1","WritingMode":"vertical"},"children":["この省令は、高齢者、障害者等の移動等の円滑化の促進に関する法律施行令の一部を改正する政令の施行の日（令和七年六月一日）から施行する。"]}]}]}]}]}]}]}}